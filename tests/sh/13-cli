# an alias that replaces another one is what its own line makes it: with
# parameters, of the shell only (an external command) or neither
testAliasRedefined()
{
    skip_if_rpm_testing_off && return

    build a
    index

    # only an alias of the system's cli.conf can be replaced. Does the poldek
    # under test have "ll = ls -l" and a less of the shell only there? The
    # list shows the first; an alias to less is found, and not listed
    mkdir -p $TMPDIR/probe
    printf '[aliases]\nprobe = less\n' > $TMPDIR/probe/.poclidekrc
    out=$(HOME=$TMPDIR/probe $POLDEK -q alias 2>&1)
    if ! echo "$out" | grep -q '^ll  *= ls -l$' ||
       echo "$out" | grep -q -e 'could not determine aliased command' -e '^less ' -e '^probe '; then
        startSkipping
        fail # to count skipping tests
        endSkipping
        return
    fi

    mkdir -p $TMPDIR/home
    printf '[aliases]\nll = ls -q %%1*\nless = ls -q\n' > $TMPDIR/home/.poclidekrc

    local listed=$(HOME=$TMPDIR/home $POLDEK -q 'ls -q a' 2>&1)

    out=$(HOME=$TMPDIR/home $POLDEK -q 'll a' 2>&1)
    assertEquals "ll a ($out)" "$listed" "$out"

    out=$(HOME=$TMPDIR/home $POLDEK -q 'less a' 2>&1)
    assertEquals "less a ($out)" "$listed" "$out"
}

# an alias with a parameter passes its argument whole, a long one too
testAliasParameterLongArgument()
{
    skip_if_rpm_testing_off && return

    build a
    index

    mkdir -p $TMPDIR/home
    printf '[aliases]\np1 = ls %%1\n' > $TMPDIR/home/.poclidekrc
    arg=$(printf 'x%.0s' $(seq 1 2000))

    out=$(HOME=$TMPDIR/home $POLDEK -q "p1 $arg" 2>&1)
    got=$(echo "$out" | cut -c1-80)
    assertEquals "ls did not get the argument ($got)" \
                 "error: $arg: no such package or directory" "$out"
}

# an alias that leads back to itself is refused, not expanded without end,
# also when the way back goes through an alias with a parameter
testAliasLoop()
{
    skip_if_rpm_testing_off && return

    build a
    index

    mkdir -p $TMPDIR/home
    printf '[aliases]\nself = self a\nloopa = loopb\nloopb = loopa\nrun = %%1\nrl = run rl\n' \
           > $TMPDIR/home/.poclidekrc

    for alias in self loopa rl; do
        out=$(HOME=$TMPDIR/home $POLDEK -q "$alias" 2>&1)
        assertEquals "$alias: exit code ($out)" "1" "$?"
        echo "$out" | grep -qx "error: $alias: alias refers to itself"
        assertEquals "$alias: no loop error ($out)" "0" "$?"
    done
}

# the aliases of the cli.conf that is installed name options their commands have
testShippedAliases()
{
    mkdir -p $TMPDIR/home
    cp ../conf/cli.conf $TMPDIR/home/.poclidekrc

    # those that run an external command have no help
    local aliases=$(sed -n '/^\[aliases\]/,$p' ../conf/cli.conf |
                    sed -n '/= *!/d; s/^\([a-zA-Z][^ =]*\) *=.*/\1/p')
    [ -n "$aliases" ] || fail "no aliases read from ../conf/cli.conf"

    for alias in $aliases; do
        out=$(HOME=$TMPDIR/home $POLDEK_NOCONF -q "$alias --help" 2>&1)
        assertEquals "$alias --help: exit code ($out)" "0" "$?"
        echo "$out" | grep -q -e 'invalid option' -e 'unrecognized option' -e 'no such command'
        assertEquals "$alias --help ($out)" "1" "$?"
    done
}

