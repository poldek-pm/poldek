# a command given as arguments: the first one is parsed as a line (so it may
# hold the command with its options, or all the commands), each of the others
# is one word, whatever it holds; a lone | or ; parts commands, and the
# argument after it is parsed as a line again
testCmdArgumentsAreWords()
{
    skip_if_rpm_testing_off && return

    local shown="grep -o ^[ab]*-1-1"

    build a
    build ab
    build b
    index

    out=$($POLDEK ls -q 'a b' 2>&1)
    echo "$out" | grep -q 'a b: no such package'
    assertEquals "'a b' is not one argument ($out)" "0" "$?"
    assertEquals "'a b' listed packages ($out)" "" "$(echo "$out" | $shown)"

    out=$($POLDEK ls -q 'a;b' 'a|b' 2>&1)
    assertEquals "'a;b' or 'a|b' is not one argument ($out)" "2" \
        "$(echo "$out" | grep -c -e 'a;b: no such package' -e 'a|b: no such package')"

    out=$($POLDEK search --perlre '|^ab|' 2>&1)
    assertEquals "search --perlre '|^ab|' failed ($out)" "0" "$?"
    assertEquals "ab-1-1 not found ($out)" "ab-1-1" "$(echo "$out" | $shown)"

    # an alias gets the words as they are
    out=$($POLDEK upgrade --test 'a b' 2>&1)
    echo "$out" | grep -q 'a b: no such package'
    assertEquals "the alias did not get 'a b' as one argument ($out)" "0" "$?"

    out=$($POLDEK 'ls -q' a 2>&1)
    assertEquals "'ls -q' a ($out)" "a-1-1" "$(echo "$out" | $shown | xargs)"

    out=$($POLDEK 'ls -q a' 'a b' 2>&1)
    echo "$out" | grep -q 'a b: no such package'
    assertEquals "'ls -q a' 'a b' ($out)" "0" "$?"

    out=$($POLDEK "search -p 'a*' | ls -q" 2>&1)
    assertEquals "a line with a pipe ($out)" "a-1-1 ab-1-1" "$(echo "$out" | $shown | xargs)"

    out=$($POLDEK search -p 'a*' '|' ls -q 2>&1)
    assertEquals "a lone | ($out)" "a-1-1 ab-1-1" "$(echo "$out" | $shown | xargs)"

    out=$($POLDEK search -p a ';' 'search -p' b 2>&1)
    assertEquals "a lone ; ($out)" "a-1-1 b-1-1" "$(echo "$out" | $shown | xargs)"

    out=$($POLDEK ls -q a '' 2>&1)
    assertEquals "an empty argument ($out)" "a-1-1" "$(echo "$out" | $shown | xargs)"
}

# !command runs an external command where a command stands, which the shell
# only allows: as an argument a word that begins with ! is a word
testExternalCommandOnlyAsCommand()
{
    skip_if_rpm_testing_off && return

    build a
    index

    out=$($POLDEK ls -q '!a' 2>&1)
    echo "$out" | grep -q '!a: no such package'
    assertEquals "ls did not get !a as an argument ($out)" "0" "$?"

    out=$($POLDEK "ls -q '!a'" 2>&1)
    echo "$out" | grep -q '!a: no such package'
    assertEquals "ls of a line did not get !a as an argument ($out)" "0" "$?"

    out=$(printf '!echo first\nls -q a; !echo second\n!echo !third\nls -q !a\n!echo fourth -h\n! echo fifth --help\n! -q echo sixth --usage\n! -q echo seventh -h\n! echo -- eighth\nquit\n' |
          timeout 60 script -qec "$POLDEK --noask --shell" /dev/null |
          tr -d '\r' | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g')
    # the shell is not in every build
    echo "$out" | grep -q 'built without interactive mode' && return
    assertEquals "!echo as a command ($out)" "1" "$(echo "$out" | grep -cx first)"
    assertEquals "!echo after ; ($out)" "1" "$(echo "$out" | grep -cx second)"
    assertEquals "!echo did not get !third as an argument ($out)" "1" "$(echo "$out" | grep -cx '!third')"
    echo "$out" | grep -q '!a: no such package'
    assertEquals "ls in the shell did not get !a as an argument ($out)" "0" "$?"
    assertEquals "!echo did not get -h as an argument ($out)" "1" "$(echo "$out" | grep -cx 'fourth -h')"
    assertEquals "! echo did not get --help as an argument ($out)" "1" "$(echo "$out" | grep -cx 'fifth --help')"
    assertEquals "echo after an option of ! did not get --usage ($out)" "1" "$(echo "$out" | grep -cx 'sixth --usage')"
    assertEquals "echo after an option of ! did not get -h ($out)" "1" "$(echo "$out" | grep -cx 'seventh -h')"
    assertEquals "echo did not get -- as an argument ($out)" "1" "$(echo "$out" | grep -cx -- '-- eighth')"
    assertEquals "help of ! where an argument of its program was -h ($out)" "0" "$(echo "$out" | grep -c 'Execute external command\|^Usage: !')"

    # a request for help among the options of ! is its help, and runs nothing
    out=$(printf '! --help\n! -q --help echo MARKER\n! -q? echo MARKER -h\n! --hel echo MARKER --help\nquit\n' |
          timeout 60 script -qec "$POLDEK --noask --shell" /dev/null |
          tr -d '\r' | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g')
    assertEquals "help of ! ($out)" "4" "$(echo "$out" | grep -c 'Execute external command')"
    assertEquals "the program was run after the help of ! ($out)" "0" "$(echo "$out" | grep -c '^MARKER')"

    # where options end at the first argument, too
    out=$(printf '! echo ninth\n! echo -- tenth\nquit\n' |
          POSIXLY_CORRECT=1 timeout 60 script -qec "$POLDEK --noask --shell" /dev/null |
          tr -d '\r' | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g')
    assertEquals "POSIXLY_CORRECT: ! echo ($out)" "1" "$(echo "$out" | grep -cx ninth)"
    assertEquals "POSIXLY_CORRECT: ! echo -- ($out)" "1" "$(echo "$out" | grep -cx -- '-- tenth')"
}

