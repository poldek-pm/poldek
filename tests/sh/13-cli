# an index of a and b with its stub index cut short, in $STUB; with "empty"
# cut before its first write
index_with_cut_stub() {
    build a
    build b
    index
    # the stub index of an index made just now gets an earlier time and is
    # not read at all, cut or not
    touch -d '-1 hour' $REPO/packages.ndir*
    $POLDEK up                  # to create stubindex

    STUB=$(ls $CACHEDIR/*/stubindex.pndir.zst)
    [ -f "$STUB" ] || fail "no stub index"
    if [ "${1:-}" = empty ]; then
        : > $STUB.cut
    else
        # like a large one cut short: the lines before the cut read whole,
        # the line of b is in a frame cut short
        zstdcat $STUB > $STUB.lines || fail "zstdcat failed"
        { grep -v '^b#' $STUB.lines | zstd -q; grep '^b#' $STUB.lines | zstd -q | head -c 10; } > $STUB.cut
        rm -f $STUB.lines
    fi
    touch -r $STUB $STUB.cut        # the file keeps its time
    mv $STUB.cut $STUB
}

# a stub index cut short is not used: install still finds a package that was
# listed after the cut
testInstallStubIndexCut()
{
    skip_if_rpm_testing_off && return

