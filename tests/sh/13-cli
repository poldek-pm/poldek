# "use sudo" is for ordinary users: root removes packages with rpm itself,
# as it installs them
testUninstallAsRootWithoutSudo()
{
    skip_if_rpm_testing_off && return
    if ! is_root; then          # the tests use sudo as an ordinary user
        startSkipping
        fail
        endSkipping
        return
    fi

    build a
    index

    build_installed a
    build_installed b

    # a sudo that refuses, so removing through it fails
    local sudo="$TMPDIR/sudo" sudo_log="$TMPDIR/sudo.log"
    printf '#!/bin/sh\necho "$*" >> %s\nexit 1\n' "$sudo_log" > $sudo
    chmod 755 $sudo
    rm -f $sudo_log

    $POLDEK -Ouse_sudo=y -Osudo_command=$sudo uninstall -y a

    assertFalse "sudo was run: $(cat $sudo_log 2>/dev/null)" "[ -s $sudo_log ]"
    rpm_state_check "b" "a"
}

# without repositories desc runs in /installed: -R and -B look among the
# installed packages
testDescInstalled()
{
    skip_if_rpm_testing_off && return

    build_installed b
    build_installed a -r b
    build_installed c -r a

    msg $RAW_POLDEK --root $DESTINATION_REPO desc -R -B a
    out=$($RAW_POLDEK --root $DESTINATION_REPO desc -R -B a)
    assertEquals "desc failed" "$?" "0"
    echo "$out" | grep -qE '^Required\(pkgs\): +sh, b$'
    assertEquals "a should require b" "$?" "0"
    echo "$out" | grep -qE '^Required\(by\): +c$'
    assertEquals "a should be required by c" "$?" "0"
}

# -R finds the owners of a required file and directory also when the
# installed packages come from the cache
testDescInstalledPathsFromCache()
{
    skip_if_rpm_testing_off && return

    build_installed f -f /usr/bin/zzf
    build_installed d -fd /usr/share/zzd/sub
    build_installed a -r /usr/bin/zzf -r /usr/share/zzd/sub
    # older than the cache made below, which then counts as current
    touch -d '-1 hour' $DESTINATION_REPO$($RPM --eval %_dbpath)/*

    for src in rpmdb rpmdbcache; do
        out=$($RAW_POLDEK --root $DESTINATION_REPO desc -R a)
        echo "$out" | grep -q "^Loading \[$src\]"
        assertEquals "installed packages not loaded from $src" "$?" "0"

        req=$(echo "$out" | grep '^Required(pkgs):')
        for p in d f; do
            echo "$req" | grep -qE "[ ,]$p(,|$)"
            assertEquals "$src: a should require $p ($req)" "$?" "0"
        done
    done
}

# and right after an install in the shell, with the installed packages
# read from the cache before it
testDescInstalledAfterInstall()
{
    skip_if_rpm_testing_off && return

    build_installed f -f /opt/zzf/tool
    build a -r /opt/zzf/tool
    index
    touch -d '-1 hour' $DESTINATION_REPO$($RPM --eval %_dbpath)/*
    $RAW_POLDEK --root $DESTINATION_REPO --cmd ls >/dev/null  # makes the cache

    out=$(printf 'cd /installed\nls\ncd /all-avail\ninstall --justdb a\ncd /installed\ndesc -R a\nquit\n' |
          timeout 60 script -qec "$POLDEK --noask --shell" /dev/null |
          tr -d '\r' | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g')
    echo "$out" | grep -q "Loading \[rpmdbcache\]"
    assertEquals "installed packages not loaded from the cache" "$?" "0"

    req=$(echo "$out" | grep 'Required(pkgs):')
    echo "$req" | grep -qE "[ ,]f(,|$)"
    assertEquals "a should require f ($req)" "$?" "0"
}

testClean()
{
    skip_if_rpm_testing_off && return

    typeset n=$(find $CACHEDIR | wc -l)
    assertEquals "$CACHEDIR should be empty" "$n" "1"

    rm -rf $CACHEDIR/*
    mkdir -p $CACHEDIR/foo/bar/baz
    touch $CACHEDIR/foo/foo.txt
    touch $CACHEDIR/foo/bar/bar.txt
    touch $CACHEDIR/foo/bar/baz/bar.txt
    mkfifo $CACHEDIR/fifo

    typeset OUTSIDEDIR="$CACHEDIR/../"
    touch $CACHEDIR/../existing-file

    ln -s ../existing-file $CACHEDIR/symlink
    ln -s ../non-existing $CACHEDIR/broken-symlink
    #ls -l $CACHEDIR/
    n=$(find $CACHEDIR | wc -l)
    #find $CACHEDIR | nl
    if [ "$n" -lt 8 ]; then
        find $CACHEDIR | nl
        fail "$CACHEDIR should contain at least 8 items"
    fi

    $RAW_POLDEK clean
    n=$(find $CACHEDIR | wc -l)
    [ "$n" != "1" ] && find $CACHEDIR
    assertEquals "$CACHEDIR should be empty after clean" "$n" "1"

    test -f $CACHEDIR/../existing-file || fail "$CACHEDIR/../existing-file should still be there"

}

# what the cache of installed packages leaves out (descriptions, file lists)
# comes from the --root database, not from the host's
testDescInstalledRootFromCache()
{
    skip_if_rpm_testing_off && return

    build_installed a -f /usr/bin/zzroot
    # a cache made within a second of a database change counts as stale;
    # back-date the database so the cache made below counts as current
    $SUDO touch -d '-1 hour' $DESTINATION_REPO$($RPM --eval %_dbpath)/* || fail "back-dating the rpm database failed"

    for src in rpmdb rpmdbcache; do
        out=$($RAW_POLDEK --root $DESTINATION_REPO desc -d -f a)
        echo "$out" | grep -q "^Loading \[$src\]"
        assertEquals "installed packages not loaded from $src" "$?" "0"
        echo "$out" | grep -qE '^Summary: +a$'
        assertEquals "$src: no summary of a ($out)" "$?" "0"
        echo "$out" | grep -qE '^/usr/bin: +zzroot$'
        assertEquals "$src: no files of a ($out)" "$?" "0"
    done
}


