# --cmd still runs the command, saying it is not needed
testCmdDeprecated()
{
    skip_if_rpm_testing_off && return

    build a
    index

    out=$($POLDEK -q --cmd "ls -q a" 2>&1)
    assertEquals "--cmd ls: exit code ($out)" "0" "$?"
    assertEquals "--cmd ls ($out)" \
        "warn: --cmd is deprecated, poldek COMMAND does the same a-1-1.noarch" \
        "$(echo "$out" | xargs)"

    # and it makes no command of the packages of an option (-i) any more
    out=$($POLDEK --noask --cmd -i a 2>&1)
    assertEquals "--cmd -i a: exit code ($out)" "0" "$?"
    rpm_state_check "a" ""

    # it is hidden
    $POLDEK --help 2>&1 | grep -q -- '--cmd'
    assertEquals "--cmd in --help" "1" "$?"
}

# ipoldek, a symlink to poldek in PLD, is poldek, saying it is deprecated
testIpoldekDeprecated()
{
    skip_if_rpm_testing_off && return

    build a
    index

    local bin=${POLDEK%% *}
    ln -sf $bin $TMPDIR/ipoldek
    out=$($TMPDIR/ipoldek ${POLDEK#$bin} -q ls -q a 2>&1)
    assertEquals "ipoldek ls: exit code ($out)" "0" "$?"
    assertEquals "ipoldek ls ($out)" \
        "warn: ipoldek is deprecated, use poldek a-1-1.noarch" "$(echo "$out" | xargs)"

    # it makes no command of the packages of an option (-i)
    out=$($TMPDIR/ipoldek ${POLDEK#$bin} --noask -i a 2>&1)
    assertEquals "ipoldek -i a: exit code ($out)" "0" "$?"
    rpm_state_check "a" ""
    rm -f $TMPDIR/ipoldek
}

# a quoted argument may begin with | or ;
testCmdQuotedPipeOrSemicolon()
{
    skip_if_rpm_testing_off && return

    build a
    build abc
    index

    out=$($POLDEK "search --perlre '|^a\$|' | install" 2>&1)
    assertEquals "search | install failed ($out)" "0" "$?"
    rpm_state_check "a" "abc"

    out=$($POLDEK "search --perlre ';^abc\$;'" 2>&1)
    assertEquals "search failed ($out)" "0" "$?"
    echo "$out" | grep -q '^abc-1-1'
    assertEquals "abc-1-1 not found ($out)" "0" "$?"
}

# a command asked for help shows it and does nothing else, however the
# option is written
testCmdHelpRunsNoCommand()
{
    skip_if_rpm_testing_off && return

    build a
    index

    for opt in --help --hel --usage '-?' '-q?' -h; do
        out=$($POLDEK -q "ls $opt a" 2>&1)
        assertEquals "ls $opt: no usage ($out)" "1" "$(echo "$out" | grep -c '^Usage: ls')"
        assertEquals "ls $opt listed a package ($out)" "0" "$(echo "$out" | grep -c '^a-1-1')"
    done

    # argp's hidden option of the name to show works as before
    out=$($POLDEK -q "ls --program-name=list --usage" 2>&1)
    assertEquals "ls --program-name=list --usage failed ($out)" "0" "$?"
    assertEquals "ls --program-name=list --usage ($out)" "1" "$(echo "$out" | grep -c '^Usage: list ')"
    out=$($POLDEK -q "ls --program-name=/bin/list --usage" 2>&1)
    assertEquals "ls --program-name=/bin/list --usage ($out)" "1" "$(echo "$out" | grep -c '^Usage: list ')"

    # past "--" it is an argument
    out=$($POLDEK -q "ls -- --help" 2>&1)
    assertEquals "ls -- --help ($out)" "0" "$(echo "$out" | grep -c '^Usage: ls')"
    echo "$out" | grep -q -- '--help: no such package'
    assertEquals "ls did not get --help as an argument ($out)" "0" "$?"
}

# each command of a line starts with the settings poldek was given: neither
# the packages nor the options of the command before it are its own
testCmdsOfLineShareNothing()
{
    skip_if_rpm_testing_off && return

    local out

    build a
    build b
    build c
    build y -r nosuchcap
    index

    out=$($POLDEK -q "ls -q a ; ls -q b ; ls -q c" 2>&1)
    assertEquals "ls ; ls ; ls" "a-1-1 b-1-1 c-1-1" "$(echo "$out" | grep -o '^[abc]-1-1' | xargs)"

    out=$($POLDEK -q ls -q a ";" ls -q b 2>&1)
    assertEquals "ls ; ls as arguments" "a-1-1 b-1-1" "$(echo "$out" | grep -o '^[abc]-1-1' | xargs)"

    out=$($POLDEK -q "ls -q a ; ls -q b | desc" 2>&1)
    assertEquals "ls ; ls | desc" "b-1-1" "$(echo "$out" | grep '^Package:' | grep -o '[ab]-1-1' | xargs)"

    # --test of the first is not the second's
    out=$($POLDEK "install --test a ; install b" 2>&1)
    rpm_state_check "b" "a"

    # nor is --nodeps
    out=$($POLDEK "install --nodeps c ; install y" 2>&1)
    rpm_state_check "b,c" "y"

    # an option of poldek is every command's
    out=$($POLDEK --test "install a ; uninstall b" 2>&1)
    rpm_state_check "b,c" "a"
}

# -q of a command does not quieten the commands after it
testCmdQuietOnlyForItself()
{
    skip_if_rpm_testing_off && return

    local out

    build a
    build b
    index

    out=$($POLDEK "install -q --test a ; install --test b" 2>&1)
    echo "$out" | grep -q 'There are 1 package to install'
    assertEquals "install after install -q said nothing ($out)" "0" "$?"

    out=$($POLDEK "ls -q a | install --test" 2>&1)
    echo "$out" | grep -q 'There are 1 package to install'
    assertEquals "install after ls -q | said nothing ($out)" "0" "$?"
