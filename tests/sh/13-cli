# a stub index that could not be written is left as it was: its time is the
# old index's, so the next load writes it again
testStubIndexWriteError()
{
    skip_if_rpm_testing_off && return

    build a
    index
    touch -d '-1 hour' $REPO/packages.ndir*
    $POLDEK up                  # to create stubindex

    local stub=$(ls $CACHEDIR/*/stubindex.pndir.zst)
    [ -f "$stub" ] || fail "no stub index"
    assertEquals "packages in the stub index" "1" "$(zstdcat $stub | grep -vc "^%")"

    build b
    index
    local out=$(env LC_ALL=C LD_PRELOAD=$PWD/preload/.libs/close_error.so \
                WRITE_ERROR=stubindex.pndir.zst $POLDEK ls 2>&1)
    echo "$out" | grep -q 'stubindex.pndir.zst: write failed (No space left on device)' ||
        fail "no write error: $out"
    assertEquals "stub index replaced" "1" "$(zstdcat $stub | grep -vc "^%")"
    left=$(find $(dirname $stub) -name '.*.tmp.??????')
    [ -z "$left" ] || fail "temporary files left: $left"

    $POLDEK ls > /dev/null 2>&1
    assertEquals "packages in the stub index" "2" "$(zstdcat $stub | grep -vc "^%")"
}

# of two packages a source takes for one it gives one, after its masks, which
# may tell them apart by how the version is written; with the stub index the
# choice is the same
testStubIndexOfDuplicates()
{
    skip_if_rpm_testing_off && return

    local conf=$TMPDIR/source-dup.conf mask left cold out cmd

    SOURCE_DATE_EPOCH=$(date -u -d 2021-05-03 +%s)
    export SOURCE_DATE_EPOCH
    build a
    mv $REPO/a-1-1.noarch.rpm $REPO/older.rpm
    build same 1-1
    SOURCE_DATE_EPOCH=$(date -u -d 2024-07-03 +%s)
    build a
    build same 01-1
    unset SOURCE_DATE_EPOCH

    for mask in "" same-01-1 same-1-1; do
        left="same-01-1"
        [ "$mask" = "same-01-1" ] && left="same-1-1"
        printf '[source]\nname = s\ntype = dir\npath = %s/\n' $REPO > $conf
        [ -n "$mask" ] && echo "ignore = $mask" >> $conf
        rm -rf $CACHEDIR

        for cmd in "ls -l a" "ls same" "desc same"; do
            cold=$($POLDEK_RAW --conf $conf --cachedir $CACHEDIR -n s -q "$cmd" 2>&1 |
                   grep -e '^a-1-1' -e '^same-' -e '^Package:')
            [ -n "$cold" ] || fail "ignore = $mask: $cmd shows nothing"
            out=$($POLDEK_RAW --conf $conf --cachedir $CACHEDIR -n s -q "$cmd" 2>&1 |
                  grep -e '^a-1-1' -e '^same-' -e '^Package:')
            assertEquals "ignore = $mask: $cmd with the stub index" "$cold" "$out"
            [ "$cmd" = "ls -l a" ] && continue
            echo "$out" | grep -q "$left" || fail "ignore = $mask: $cmd does not show $left ($out)"
        done
    done
}

# a directory index that could not be written is left as it was, with its
# time, so the next load still finds it outdated and writes it again
testDirIndexWriteError()
{
    skip_if_rpm_testing_off && return

    build a
    index
    touch -d '-1 hour' $REPO/packages.ndir*
    $POLDEK up                  # to create dirindex

    local dirindex=$(ls $CACHEDIR/*/dirindex.pndir.tndb)
    [ -f "$dirindex" ] || fail "no dirindex"
    local before=$(cksum < $dirindex) mtime=$(stat -c %Y $dirindex)

    build b
    index
    env LD_PRELOAD=$PWD/preload/.libs/close_error.so WRITE_ERROR=dirindex.pndir.tndb \
        $POLDEK up > /dev/null 2>&1
    assertEquals "dirindex replaced" "$before" "$(cksum < $dirindex)"
    assertEquals "time of the old dirindex changed" "$mtime" "$(stat -c %Y $dirindex)"
    left=$(find $(dirname $dirindex) -name '.*.tmp.??????')
    [ -z "$left" ] || fail "temporary files left: $left"

    $POLDEK up > /dev/null 2>&1
    [ "$(cksum < $dirindex)" != "$before" ] || fail "dirindex not written again"
}

# a record of the directory index that cannot be read (its value length set
# past the end, the index signed again) is reported, and the directory index
# is made again: $1 is the prefix of the key of the record
check_dirindex_broken_record()
{
    build a 1-1 -f /opt/zzdir/data      # so that its directories follow the key map
    index
    $POLDEK up                          # to create dirindex

    local dirindex=$(ls $CACHEDIR/*/dirindex.pndir.tndb)
    [ -f "$dirindex" ] || fail "no dirindex"
    python3 -I $SHLIBDIR/tndb-set-vlen $dirindex "$1" 0xffffffff ||
        fail "tndb-set-vlen failed"
    local broken=$(cksum < $dirindex)

    # in testing mode poldek aborts at a broken dirindex
    local out=$(env -u POLDEK_TESTING $POLDEK -Oauto_directory_dependencies=y ls 2>&1)
    echo "$out" | grep -q 'invalid directory index' ||
        fail "no error for the broken record: $out"
    [ "$(cksum < $dirindex)" != "$broken" ] || fail "the broken dirindex was kept"
    $POLDEK -Oauto_directory_dependencies=y ls > /dev/null 2>&1 ||
        fail "the dirindex made again does not verify"
}

# the first record after the key map, rather than read as a package
# without directories
testDirIndexBrokenRecord()
{
    skip_if_rpm_testing_off && return
    check_dirindex_broken_record '_\a#'
}

# the first record of the key map, rather than read as the end of an
