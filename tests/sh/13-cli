# a mask is matched with the whole name-version-release of a package, however
# long the name of its source is
testIgnoreMaskLongSourceName()
{
    skip_if_rpm_testing_off && return

    local conf="$TMPDIR/source-ignore.conf" name type out

    build a
    build b
    index

    name=$(printf 's%.0s' $(seq 1 507))
    for type in pndir dir; do
        printf '[source]\nname = %s\ntype = %s\npath = %s/\nignore = a-1-1\n' $name $type $REPO > $conf
        rm -rf $CACHEDIR
        out=$($POLDEK_RAW --conf $conf --cachedir $CACHEDIR -n $name ls 2>&1)
        assertEquals "$type: ignore = a-1-1 ($out)" "b-1-1" "$(echo "$out" | grep -o '^[ab]-1-1' | xargs)"

        printf '[source]\nname = %s\ntype = %s\npath = %s/\nignore = a-1\n' $name $type $REPO > $conf
        rm -rf $CACHEDIR
        out=$($POLDEK_RAW --conf $conf --cachedir $CACHEDIR -n $name ls 2>&1)
        assertEquals "$type: ignore = a-1 ($out)" "a-1-1 b-1-1" "$(echo "$out" | grep -o '^[ab]-1-1' | xargs)"
    done

    printf '[source]\nname = %s\ntype = dir\npath = %s/\nignore = %s:b-1-1.noarch\n' $name $REPO $name > $conf
    rm -rf $CACHEDIR
    out=$($POLDEK_RAW --conf $conf --cachedir $CACHEDIR -n $name ls 2>&1)
    assertEquals "dir: ignore = NAME:b-1-1.noarch ($out)" "a-1-1" "$(echo "$out" | grep -o '^[ab]-1-1' | xargs)"
}

# -vvv names each package the source ignores the same way, however it comes
# to be ignored: dropped after the load that writes the stub index, left out
# of the stub index as it is read, or skipped in the index by a later load
testSourceIgnoreVerbose()
{
    skip_if_rpm_testing_off && return

    local conf="$TMPDIR/source-ignore.conf" opt name out

    build a
    build b
    index
    touch -d '-1 hour' $REPO/packages.ndir.*    # for the stub index to stay current
    printf '[source]\nname = s\ntype = pndir\npath = %s/\nignore = a*\n' $REPO > $conf

    for opt in "" "-Omultilib=0"; do
        name="a-1-1.noarch"
        [ -n "$opt" ] && name="a-1-1"
        rm -rf $CACHEDIR

        # the second run reads the stub index, then loads the source for desc
        for cmd in ls "desc b"; do
            out=$($POLDEK_RAW $opt --conf $conf --cachedir $CACHEDIR -n s -vvv "$cmd" 2>&1)
            assertEquals "$cmd ignoring a failed, $opt ($out)" "0" "$?"
            echo "$out" | grep -q "^ *ignored $name$" ||
                fail "$cmd $opt: no 'ignored $name' ($out)"
            [ "$cmd" = ls ] || echo "$out" | grep -q 'Loading stub index' ||
                fail "$cmd $opt: the stub index was not read ($out)"
            assertEquals "$cmd $opt: a named another way ($out)" "" \
                "$(echo "$out" | grep 'ignored a-' | grep -v "^ *ignored $name$")"
        done
    done
}

# an ignore mask in a source section hides what it hides in [ global ],
# whatever the type of the source: a name, a name-version-release, one with
# the arch, a glob, each also after the name of the source
testSourceIgnoreMasks()
{
    skip_if_rpm_testing_off && return

    local conf="$TMPDIR/source-ignore.conf" type mask shown out rc

    build a
    build ab
    index

    for type in pndir dir; do
        for mask in a a-1-1 a-1-1.noarch 'a-[0-9]*' s:a 's:a-1*' other:a a.noarch; do
            shown="ab-1-1"
            case $mask in other:a | a.noarch) shown="a-1-1 ab-1-1" ;; esac

            printf '[source]\nname = s\ntype = %s\npath = %s/\nignore = %s\n' $type $REPO "$mask" > $conf
            rm -rf $CACHEDIR    # no stub index from the mask before
            out=$($POLDEK_RAW --conf $conf --cachedir $CACHEDIR -n s ls 2>&1)
            rc=$?
            assertEquals "ls of $type with ignore = $mask failed ($out)" "0" "$rc"
            assertEquals "$type: ignore = $mask ($out)" "$shown" \
                "$(echo "$out" | grep -o '^ab*-1-1' | xargs)"
        done
    done
}

# ls of a source: $1 its type, $2 the ignore line of its section, or none;
# the output in $out, the packages shown in $shown
ls_source()
{
    printf '[source]\nname = s\ntype = %s\npath = %s/\n%s\n' $1 $REPO "$2" > $TMPDIR/source-ignore.conf
    out=$($POLDEK_RAW --conf $TMPDIR/source-ignore.conf --cachedir $CACHEDIR -n s -vv ls 2>&1)
    shown=$(echo "$out" | grep -o '^[ab]-1-1' | xargs)
}

# ignore of a source hides the same packages with a cold cache and with a
# stub index in it, whatever masks were set when the stub index was written
testSourceIgnoreWithStubIndex()
{
    skip_if_rpm_testing_off && return

    local type out shown stub

    build a
    build b
    index
    for type in pndir dir; do
        # a stub index is current while it has the time of its source: of
        # the index or, with dir, of the directory
        touch -d '-1 hour' $REPO/packages.ndir.* $REPO
        rm -rf $CACHEDIR
        ls_source $type "ignore = a"
        assertEquals "$type: ignore = a, a cold cache ($out)" "b-1-1" "$shown"
        stub=$(find $CACHEDIR -name "stubindex.$type.zst")
        assertEquals "$type: packages in the stub index written with ignore = a" "2" \
            "$(zstdcat $stub | grep -vc "^%")"

        ls_source $type ""
        assertEquals "$type: no mask after ignore = a ($out)" "a-1-1 b-1-1" "$shown"
        echo "$out" | grep -q 'Loading \[' && fail "$type: the source was loaded, not its stub index ($out)"

        ls_source $type "ignore = a"
        assertEquals "$type: ignore = a, a warm cache ($out)" "b-1-1" "$shown"
        echo "$out" | grep -q 'Loading \[' && fail "$type: the source was loaded, not its stub index ($out)"

        ls_source $type "ignore = s:a"
        assertEquals "$type: ignore = s:a, a warm cache ($out)" "b-1-1" "$shown"
        echo "$out" | grep -q 'Loading \[' && fail "$type: the source was loaded, not its stub index ($out)"

        ls_source $type ""
        assertEquals "$type: no mask, a warm cache ($out)" "a-1-1 b-1-1" "$shown"
        echo "$out" | grep -q 'Loading \[' && fail "$type: the source was loaded, not its stub index ($out)"

        # a stub index of a version that wrote it without the ignored packages
        zstdcat $stub | grep -v -e '^%' -e '^a#' | zstd -q -c > $stub.old
        touch -r $stub $stub.old
        mv -f $stub.old $stub
        ls_source $type ""
        assertEquals "$type: no mask, a stub index without a left ($out)" "a-1-1 b-1-1" "$shown"
        assertEquals "$type: the stub index was not written again" "%stubindex v2" "$(zstdcat $stub | head -1)"

        # one of another version of the format
        zstdcat $stub | sed -e '1s/.*/%stubindex v3/' -e '/^a#/d' | zstd -q -c > $stub.old
        touch -r $stub $stub.old
        mv -f $stub.old $stub
        ls_source $type ""
        assertEquals "$type: no mask, a stub index of v3 without a ($out)" "a-1-1 b-1-1" "$shown"
        assertEquals "$type: the stub index of v3 was not written again" "%stubindex v2" "$(zstdcat $stub | head -1)"
    done
}

# what the cache of installed packages leaves out (descriptions, file lists)
# comes from the --root database, not from the host's
testDescInstalledRootFromCache()
{
    skip_if_rpm_testing_off && return

    build_installed a -f /usr/bin/zzroot
    # a cache made within a second of a database change counts as stale;
    # back-date the database so the cache made below counts as current
    touch -d '-1 hour' $DESTINATION_REPO$($RPM --eval %_dbpath)/* || fail "back-dating the rpm database failed"

    for src in rpmdb rpmdbcache; do
        out=$($RAW_POLDEK --root $DESTINATION_REPO desc -d -f a)
        echo "$out" | grep -q "^Loading \[$src\]"
        assertEquals "installed packages not loaded from $src" "$?" "0"
        echo "$out" | grep -qE '^Summary: +a$'
        assertEquals "$src: no summary of a ($out)" "$?" "0"
        echo "$out" | grep -qE '^/usr/bin: +zzroot$'
        assertEquals "$src: no files of a ($out)" "$?" "0"
    done
}

# search --perlre takes /regexp/flags
testSearchPerlRegexp()
{
    skip_if_rpm_testing_off && return

    build a
    build abc
    index

    out=$($POLDEK search --perlre '/^A$/i' 2>&1)
    assertEquals "search failed ($out)" "0" "$?"
    echo "$out" | grep -q '^a-1-1'
    assertEquals "a-1-1 not found ($out)" "0" "$?"
    n=$(echo "$out" | grep -c '^abc-1-1')
    assertEquals "abc-1-1 found ($out)" "0" "$n"

    out=$($POLDEK search --perlre '/^A$/' 2>&1)
    n=$(echo "$out" | grep -c '^a-1-1')
    assertEquals "a-1-1 found without the i flag ($out)" "0" "$n"

    out=$($POLDEK search --perlre '/(/' 2>&1)
    echo "$out" | grep -q 'search: pattern: (:1: '
    assertEquals "no error for an invalid pattern ($out)" "0" "$?"
}


