# A part of the URL that only one repository has names it too; a part
# that more than one has removes nothing
testRepoDeleteByUrlFragment()
{
    local tmp=${TMPDIR:-/tmp}
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $tmp/repo-frag-a-19.conf <<EOF
[source]
name = frag-a-19
path = http://example.com/frag/a
type = pndir
EOF

    cat > $tmp/repo-frag-b-19.conf <<EOF
[source]
name = frag-b-19
path = http://example.com/frag/b
type = pndir
EOF

    $POLDEK repo add $tmp/repo-frag-a-19.conf
    assertEquals "repo add a failed" "0" "$?"
    $POLDEK repo add $tmp/repo-frag-b-19.conf
    assertEquals "repo add b failed" "0" "$?"

    out=$($POLDEK repo del repo-frag- 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a fragment of more than one repo should remove nothing"
    fi
    echo "$out" | grep -q "matches 2 repositories" || \
        fail "the ambiguity not named: $out"
    echo "$out" | grep -q "$tmp/repo-frag-a-19.conf" || \
        fail "the first repository not listed: $out"
    echo "$out" | grep -q "$tmp/repo-frag-b-19.conf" || \
        fail "the second repository not listed: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "both repositories expected to stay" "2" "$n"

    out=$($POLDEK repo del frag-a-19 2>&1)
    assertEquals "repo del by a unique fragment failed" "0" "$?"
    echo "$out" | grep -q "$tmp/repo-frag-a-19.conf repo has been removed" || \
        fail "the removed repository's origin not named: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "one repository expected to stay" "1" "$n"

    out=$($POLDEK repo ls 2>&1)
    echo "$out" | grep -q "frag-b-19" || fail "the other repository is gone: $out"
    echo "$out" | grep -q "frag-a-19" && fail "the removed repository is listed: $out"
    return 0
}

# repos.d is poldek's own directory: a file there without the marker is
# removed as well
testRepoDeleteUnmarkedFile()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/unmarked.conf <<EOF
[source]
name = unmarked-test-19
path = http://example.com/unmarked
type = pndir
EOF

    $POLDEK repo del unmarked.conf
    assertEquals "repo del of an unmarked repos.d file" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "unmarked .conf expected to be removed" "0" "$n"
}

# Nothing to remove from repos.d: say so and fail, do not crash
testRepoDeleteMissingReposd()
{
    local tmp=${TMPDIR:-/tmp}
    export POLDEK_TESTING_REPOSDIR=$tmp/no-reposd-19
    rm -rf $POLDEK_TESTING_REPOSDIR

    out=$($POLDEK repo del anything 2>&1)
    rc=$?

    assertEquals "repo del without repos.d fails" "1" "$rc"
    echo "$out" | grep -q "no such repo" || fail "no reason given: $out"
}

# A URL that matches no repository leaves the repositories alone
testRepoDeleteUnknownUrl()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    $POLDEK repo del http://example.com/not-there-19
    if [ "$?" -eq 0 ]; then
        fail "repo del of an unknown URL should fail"
    fi

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "the repository expected to stay" "1" "$n"
}

# A command and its arguments are checked before anything runs
testRepoUsageRejected()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    out=$($POLDEK repo rm-from-nowhere 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "an unknown command should fail"
    fi
    echo "$out" | grep -q "unknown command" || fail "no reason given: $out"

    out=$($POLDEK repo add 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "add without a URL should fail"
    fi
    echo "$out" | grep -q "URL is required" || fail "no reason given: $out"

    out=$($POLDEK repo del 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "del without a URL should fail"
    fi
    echo "$out" | grep -q "URL is required" || fail "no reason given: $out"

    out=$($POLDEK repo ls $REMOTE_CONF 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "ls takes no arguments"
    fi
    echo "$out" | grep -q "takes no arguments" || fail "no reason given: $out"

    out=$($POLDEK repo --force ls 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "--force is only for add"
    fi
    echo "$out" | grep -q "only for add" || fail "no reason given: $out"

    out=$($POLDEK repo add $REMOTE_CONF another 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "add takes one URL"
    fi
    echo "$out" | grep -q "takes one URL" || fail "no reason given: $out"

    out=$($POLDEK repo del $REMOTE_CONF another 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "del takes one URL"
    fi
    echo "$out" | grep -q "takes one URL" || fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no repository expected" "0" "$n"
}

# With no command repo lists the repositories, as repo ls does
testRepoWithoutCommandLists()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    out=$($POLDEK repo 2>&1)
    assertEquals "repo without a command failed" "0" "$?"
    echo "$out" | grep -q "poldekrepo-test-19" || \
        fail "repository not listed: $out"

    out=$($POLDEK repo ls 2>&1)
    assertEquals "repo ls failed" "0" "$?"
    echo "$out" | grep -q "poldekrepo-test-19" || \
        fail "repository not listed by ls: $out"
}

# Local policy is the user's: ignore, hold and auto are not taken from
# the downloaded configuration
testRepoAddStripsLocalPolicy()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REMOTE_CONF <<EOF
[source]
name = policy-test-19
path = http://example.com/policy
type = pndir
ignore = *
hold = *
auto = yes
noauto = yes
EOF

    $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    grep -q '^ignore' $fn && fail "ignore was saved"
    grep -q '^hold' $fn && fail "hold was saved"
    grep -q '^noauto' $fn && fail "noauto was saved"
    grep -q '^auto = no$' $fn || fail "auto = no was not forced"
    return 0
}

# Sources from the built-in repos.d are listed after the user's and
# flagged as managed
testRepoManagedSourcesListed()
{
    local tmp=${TMPDIR:-/tmp}
    local home=$tmp/home-19
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $home
    mkdir -p $home

    cat > $home/.poldekrc <<EOF
[global]
cachedir = $home/cache

[source]
name = plain-test-19
path = $tmp/plain-19/
type = pndir
EOF

    $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    out=$(HOME=$home $POLDEK up -l 2>&1)
    assertEquals "up -l failed" "0" "$?"

    echo "$out" | grep -q '^plain-test-19 ' || fail "user source not listed: $out"
    echo "$out" | grep -q 'poldekrepo-test-19.*(managed' || \
        fail "managed source not flagged: $out"

    plain=$(echo "$out" | grep -n 'plain-test-19' | cut -d: -f1)
    managed=$(echo "$out" | grep -n 'poldekrepo-test-19' | cut -d: -f1)
    if [ -n "$plain" ] && [ -n "$managed" ] && [ "$managed" -le "$plain" ]; then
        fail "managed sources should be listed last: $out"
    fi
}

testRepoGlobalIgnored()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/global-poison.conf <<EOF
# remote repository managed by poldek http://example.com/poison
[global]
source = global-hijack,compr=zst /nonexistent/repo/

[source]
name = managed-test-19
path = /nonexistent/repo/
type = pndir
EOF

    out=$($POLDEK -l 2>&1)
    echo "$out" | grep -q "global-hijack" && \
        fail "[global] from repos.d should be ignored, but global-hijack was listed: $out"

    echo "$out" | grep -q "managed-test-19" || \
        fail "managed-test-19 source not listed: $out"
}

. ./sh/lib/shunit2
