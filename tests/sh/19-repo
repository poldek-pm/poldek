#!/bin/sh
# $Id$

# repo command tests

. ./sh/lib/setup

POLDEK="$PWD/../cli/poldek"
$POLDEK --version >/dev/null 2>&1

REPOSD=
REMOTE_CONF=
INVALID_CONF=

setUp() {
    local tmp=${TMPDIR:-/tmp}
    REPOSD=$tmp/reposd-19
    REMOTE_CONF=$tmp/remote-19.conf
    INVALID_CONF=$tmp/invalid-19.conf

    rm -rf $REPOSD
    mkdir -p $REPOSD

    cat > $REMOTE_CONF <<EOF
[source]
name = poldekrepo-test-19
path = http://example.com/poldek
type = pndir
EOF

    cat > $INVALID_CONF <<EOF
[source]
name = invalid-test-19
path = http://example.com/invalid
foo = bar
EOF
}

testRepoAddListDelete()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo -a $REMOTE_CONF
    assertEquals "repo -a failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "one managed .conf expected" "1" "$n"

    out=$($POLDEK repo -l)
    echo "$out" | grep -q "poldekrepo-test-19" || \
        fail "repo -l does not show the added source: $out"

    fn=$(basename $(ls $REPOSD/*.conf))
    $POLDEK repo -d $fn
    assertEquals "repo -d failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no managed .conf expected after delete" "0" "$n"
}

testRepoOverwrite()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo -a $REMOTE_CONF
    assertEquals "first repo -a failed" "0" "$?"

    $POLDEK repo -a $REMOTE_CONF
    if [ "$?" -eq 0 ]; then
        fail "second repo -a should fail without --overwrite"
    fi

    $POLDEK repo -a $REMOTE_CONF --force
    assertEquals "repo -a --force failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "one managed .conf expected after overwrite" "1" "$n"
}

testRepoInvalidRejected()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo -a $INVALID_CONF
    if [ "$?" -eq 0 ]; then
        fail "repo -a with invalid config should fail"
    fi

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected after rejected add" "0" "$n"
}

testRepoDuplicateNameAcrossFiles()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/first.conf <<EOF
# remote repository managed by poldek http://example.com/first
[source]
name = duplicate-test-19
path = http://example.com/first
type = pndir
EOF

    cat > $REPOSD/second.conf <<EOF
# remote repository managed by poldek http://example.com/second
[source]
name = duplicate-test-19
path = http://example.com/second
type = pndir
EOF

    $POLDEK repo -l
    if [ "$?" -eq 0 ]; then
        fail "duplicate source names across files should be rejected"
    fi
}

testRepoBaseUrlMacro()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD
    SHLIBDIR="$PWD/sh/lib"
    CACHEDIR=${TMPDIR:-/tmp}/poldek-cache-19
    rm -rf $CACHEDIR
    mkdir -p $CACHEDIR

    cat > $REMOTE_CONF <<EOF
[source]
name = baseurl-test-19
path = %{_baseurl}/%{_arch}/
type = pndir
EOF

    POLDEK_TESTING_PRELOAD_CONF="$SHLIBDIR/vftest-fetch.conf"
    export POLDEK_TESTING_PRELOAD_CONF
    PATH="$PATH:$SHLIBDIR"
    export PATH

    $POLDEK --cachedir $CACHEDIR repo -a test:/$REMOTE_CONF
    assertEquals "repo -a failed" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    grep -q "^_baseurl = " $fn || fail "missing _baseurl macro in saved file"
    grep -q "^_origin = " $fn || fail "missing _origin macro in saved file"
    grep -q "^__dirname = " $fn && fail "internal __dirname macro leaked into saved file"
    grep -q '^path = %{_baseurl}' $fn || fail "path should keep %{_baseurl} macro in saved file"
    grep -qE '^path = /' $fn && fail "path was expanded to absolute local path in saved file"
    grep -q '^auto = no$' $fn || fail "missing auto = no in saved file"

    out=$($POLDEK --cachedir $CACHEDIR repo -l 2>&1)

    echo "$out" | grep -q "baseurl-test-19" || fail "source not listed: $out"
    echo "$out" | grep -q "test:/$REMOTE_CONF" || fail "_origin URL not listed: $out"

    local arch=$(rpm --eval '%{_target_cpu}')
    echo "$out" | grep -q "test:/$(dirname $REMOTE_CONF)/$arch/" || fail "expanded path not listed: $out"
}

testRepoDeleteByUrl()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD
    SHLIBDIR="$PWD/sh/lib"
    CACHEDIR=${TMPDIR:-/tmp}/poldek-cache-19
    rm -rf $CACHEDIR
    mkdir -p $CACHEDIR

    cat > $REMOTE_CONF <<EOF
[source]
name = del-by-url-test-19
path = %{_baseurl}/%{_arch}/
type = pndir
EOF

    POLDEK_TESTING_PRELOAD_CONF="$SHLIBDIR/vftest-fetch.conf"
    export POLDEK_TESTING_PRELOAD_CONF
    PATH="$PATH:$SHLIBDIR"
    export PATH

    $POLDEK --cachedir $CACHEDIR repo -a test://$REMOTE_CONF
    assertEquals "repo -a failed" "0" "$?"

    $POLDEK --cachedir $CACHEDIR repo -d test://$REMOTE_CONF
    assertEquals "repo -d by URL failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected after delete by URL" "0" "$n"
}

# repos.d is poldek's own directory: a file there without the marker is
# removed as well
testRepoDeleteUnmarkedFile()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/unmarked.conf <<EOF
[source]
name = unmarked-test-19
path = http://example.com/unmarked
type = pndir
EOF

    $POLDEK repo -d unmarked.conf
    assertEquals "repo -d of an unmarked repos.d file" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "unmarked .conf expected to be removed" "0" "$n"
}

# Nothing to remove from repos.d: say so and fail, do not crash
testRepoDeleteMissingReposd()
{
    local tmp=${TMPDIR:-/tmp}
    export POLDEK_TESTING_REPOSDIR=$tmp/no-reposd-19
    rm -rf $POLDEK_TESTING_REPOSDIR

    out=$($POLDEK repo -d anything 2>&1)
    rc=$?

    assertEquals "repo -d without repos.d fails" "1" "$rc"
    echo "$out" | grep -q "no such repo" || fail "no reason given: $out"
}

# A URL that matches no repository leaves the repositories alone
testRepoDeleteUnknownUrl()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo -a $REMOTE_CONF
    assertEquals "repo -a failed" "0" "$?"

    $POLDEK repo -d http://example.com/not-there-19
    if [ "$?" -eq 0 ]; then
        fail "repo -d of an unknown URL should fail"
    fi

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "the repository expected to stay" "1" "$n"
}

# One action at a time: -a, -d and -l are mutually exclusive
testRepoActionsMutuallyExclusive()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    out=$($POLDEK repo -a $REMOTE_CONF -d foo.conf 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "repo -a -d should fail"
    fi
    echo "$out" | grep -q "mutually exclusive" || \
        fail "no reason given: $out"

    out=$($POLDEK repo -l -a $REMOTE_CONF 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "repo -l -a should fail"
    fi
    echo "$out" | grep -q "mutually exclusive" || \
        fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no repository expected" "0" "$n"
}

# Local policy is the user's: ignore, hold and auto are not taken from
# the downloaded configuration
testRepoAddStripsLocalPolicy()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REMOTE_CONF <<EOF
[source]
name = policy-test-19
path = http://example.com/policy
type = pndir
ignore = *
hold = *
auto = yes
noauto = yes
EOF

    $POLDEK repo -a $REMOTE_CONF
    assertEquals "repo -a failed" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    grep -q '^ignore' $fn && fail "ignore was saved"
    grep -q '^hold' $fn && fail "hold was saved"
    grep -q '^noauto' $fn && fail "noauto was saved"
    grep -q '^auto = no$' $fn || fail "auto = no was not forced"
    return 0
}

# Sources from the built-in repos.d are listed after the user's and
# flagged as managed
testRepoManagedSourcesListed()
{
    local tmp=${TMPDIR:-/tmp}
    local home=$tmp/home-19
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $home
    mkdir -p $home

    cat > $home/.poldekrc <<EOF
[global]
cachedir = $home/cache

[source]
name = plain-test-19
path = $tmp/plain-19/
type = pndir
EOF

    $POLDEK repo -a $REMOTE_CONF
    assertEquals "repo -a failed" "0" "$?"

    out=$(HOME=$home $POLDEK up -l 2>&1)
    assertEquals "up -l failed" "0" "$?"

    echo "$out" | grep -q '^plain-test-19 ' || fail "user source not listed: $out"
    echo "$out" | grep -q 'poldekrepo-test-19.*(managed' || \
        fail "managed source not flagged: $out"

    plain=$(echo "$out" | grep -n 'plain-test-19' | cut -d: -f1)
    managed=$(echo "$out" | grep -n 'poldekrepo-test-19' | cut -d: -f1)
    if [ -n "$plain" ] && [ -n "$managed" ] && [ "$managed" -le "$plain" ]; then
        fail "managed sources should be listed last: $out"
    fi
}

testRepoGlobalIgnored()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/global-poison.conf <<EOF
# remote repository managed by poldek http://example.com/poison
[global]
source = global-hijack,compr=zst /nonexistent/repo/

[source]
name = managed-test-19
path = /nonexistent/repo/
type = pndir
EOF

    out=$($POLDEK -l 2>&1)
    echo "$out" | grep -q "global-hijack" && \
        fail "[global] from repos.d should be ignored, but global-hijack was listed: $out"

    echo "$out" | grep -q "managed-test-19" || \
        fail "managed-test-19 source not listed: $out"
}

. ./sh/lib/shunit2
