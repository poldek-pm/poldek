# signkey: a package from a source may only use that source's key, even
# when the package is signed by another key trusted globally by rpm
testRPMsignkeySourceIsolation() {
    skip_if_rpm_testing_off && return

    signkey_test_prepare
    local key="$SIGNKEY_TEST_KEY"
    local gpglog="$TMPDIR/signkey-gpg.log"
    local conf="$TMPDIR/signkey.conf"

    gpg --batch --no-tty --pinentry-mode loopback --passphrase '' \
        --quick-generate-key 'Wrong test key <wrong@poldek.invalid>' \
        rsa2048 sign 0 >>"$gpglog" 2>&1 || fail "cannot generate wrong key"

    gpg --armor --export 'Wrong test key' > "$TMPDIR/wrong-key.asc" \
        2>>"$gpglog"
    build_package "$REPO" poldek-signkey-bad 1-1 \
        -f /usr/share/poldek-signkey-bad/README
    local wrongfp=$(gpg --list-keys --with-colons 'Wrong test key' \
                      2>>"$gpglog" |
                    awk -F: '$1 == "fpr" { print $10; exit }')
    rpmsign --addsign --define "_gpg_name $wrongfp" \
        "$REPO/poldek-signkey-bad-1-1.noarch.rpm" >>"$gpglog" 2>&1 ||
        fail "cannot sign package with wrong key"

    # rpm now trusts the wrong key globally; only the per-source keyring
    # must reject the package
    $RPM --import "$TMPDIR/wrong-key.asc"

    cat > "$conf" <<EOF
[source]
name = signed
type = dir
path = $REPO
signed = yes
signkey = $key
EOF

    local out
    if out=$($POLDEK --conf "$conf" --root "$DESTINATION_REPO" \
        --justdb --nodeps --noask -q --install poldek-signkey-bad 2>&1); then
        echo "$out"
        fail "package signed by another repo's key was accepted"
    fi

    if $RPM -q poldek-signkey-bad >/dev/null 2>&1; then
        fail "package signed by another repo's key was installed"
    fi
}

