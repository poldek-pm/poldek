#!/bin/sh
# tests with rpm installations (--justdb is used)

. ./sh/lib/setup
. ./sh/lib/repo-setup
. ./sh/lib/solver-setup
. ./sh/lib/rpm-setup

ORIGREPO=
DESTINATION_REPO=
DEPENDENCY_SOLVER=3

setUp() {
    rpm_up

    is_rpm_testing_off && return
    # provide /bin/sh auto requirement
    rpm_build_installed sh -p /bin/sh
}

tearDown() {
    is_rpm_testing_off && return
    rpm_down
}

build() {
    build_package $REPO $@
}

build_installed() {
    rpm_build_installed $@
}

try_install() {
  rpm_install "$@"
}

testRPMdbcache() {
    skip_if_rpm_testing_off && return

    build foo

    local op=""
    is_verbose_mode && op="-v"

    msgn "create rpmdb cache with dirindex"
    msgn "$RAW_POLDEK -Oauto_directory_dependencies=y --root $DESTINATION_REPO $op --cmd ls"
    $RAW_POLDEK -Oauto_directory_dependencies=y --root $DESTINATION_REPO $op --cmd ls >/dev/null
    local rpmdb_cachedirname="$(echo $DESTINATION_REPO | sed -e 's|^/||' -e 's|/|.|g').var.lib.rpm"
    local suffix="rpmdbcache$(echo $DESTINATION_REPO | sed 's|/|.|g').var.lib.rpm"

    # check presence of dbcache
    for i in zst md zst.md5; do
        local name="packages.$suffix.$i"
        [ -f "$CACHEDIR/$name" ] || fail "missing expected $name in $CACHEDIR"
    done

    # check presence of dbcache's dirindex
    for i in tndb tndb.md5; do
        local name="dirindex.$suffix.$i"
        [ -f "$CACHEDIR/$name" ] || fail "missing expected $name in $CACHEDIR"
    done

    local dirindex_path="$CACHEDIR/$rpmdb_cachedirname/dirindex.rpmdb.tndb"
    local md5=$(md5sum $dirindex_path | cut -f1 -d' ')


    # will die (we're in test mode) if dirindex is missing
    $RAW_POLDEK -Oauto_directory_dependencies=y --st dir -s $REPO --root $DESTINATION_REPO $op --cmd ls -u >/dev/null
    assertEquals "died" "$?" "0"
    msgn "install a"
    local md=$(md5sum $dirindex_path | cut -f1 -d' ')
    assertEquals "dirindex changed" "$md5" "$md"

    build a "1-1"

    try_install a "a-1-1" ""

    msgn "update dirindex"
    # should load rpmdb and update dirindex
    $RAW_POLDEK -Oauto_directory_dependencies=y --st dir -s $REPO --root $DESTINATION_REPO $op --cmd ls -u >/dev/null

    local md=$(md5sum $dirindex_path | cut -f1 -d' ')
    if [ "$md5" = "$md" ]; then
        fail "$dirindex_path: dirindex not changed ($md5)"
    fi
}

signkey_test_prepare() {
    local keydir="$TMPDIR/signkey-test"
    local gpglog="$TMPDIR/signkey-gpg.log"
    export GNUPGHOME="$keydir/gnupg"
    export XDG_RUNTIME_DIR="$keydir/run"

    rm -rf "$keydir"
    mkdir -p "$GNUPGHOME" "$XDG_RUNTIME_DIR"
    chmod 700 "$GNUPGHOME" "$XDG_RUNTIME_DIR"
    gpgconf --launch gpg-agent

    gpg --batch --no-tty --pinentry-mode loopback --passphrase '' \
        --quick-generate-key 'Poldek test key <test@poldek.invalid>' \
        rsa2048 sign 0 >>"$gpglog" 2>&1 ||
        fail "gpg key generation failed (see $gpglog)"

    gpg --armor --export 'Poldek test key' > "$keydir/key.asc" 2>>"$gpglog"

    build_package "$REPO" poldek-signkey-test 1-1 \
        -f /usr/share/poldek-signkey-test/README

    local fp=$(gpg --list-keys --with-colons 2>>"$gpglog" |
                 awk -F: '$1 == "fpr" { print $10; exit }')
    rpmsign --addsign --define "_gpg_name $fp" \
        "$REPO/poldek-signkey-test-1-1.noarch.rpm" >>"$gpglog" 2>&1 ||
        fail "rpmsign failed (see $gpglog)"

    SIGNKEY_TEST_KEY="$keydir/key.asc"
}

# signkey: a key already present in the target rpmdb must not be imported
# again, even in a fresh poldek process
testRPMsignkeyAlreadyPresent() {
    skip_if_rpm_testing_off && return

    signkey_test_prepare
    local key="$SIGNKEY_TEST_KEY"
    local pkg="$REPO/poldek-signkey-test-1-1.noarch.rpm"
    local conf="$TMPDIR/signkey.conf"
    local calls="$TMPDIR/rpm-calls.log"
    local wrapper="$TMPDIR/rpm-wrapper"

    [ -f "$key" ] || fail "missing test key: $key"
    [ -f "$pkg" ] || fail "missing signed test package: $pkg"

    $RPM --import "$key"

    cat > "$conf" <<EOF
[source]
name = signed
type = dir
path = $REPO
signed = yes
signkey = $key
EOF

    : > "$calls"
    cat > "$wrapper" <<EOF
#!/bin/sh
echo "\$@" >> "$calls"
exec "$(command -v rpm)" "\$@"
EOF
    chmod +x "$wrapper"

    local out
    if ! out=$($POLDEK --conf "$conf" --root "$DESTINATION_REPO" \
        --pmcmd "$wrapper" --justdb --nodeps --noask -q \
        --install poldek-signkey-test 2>&1); then
        echo "$out"
        fail "install of signed test package failed"
    fi

    if grep -q -- '--import' "$calls"; then
        fail "signing key imported although it was already in rpmdb"
    fi
}

