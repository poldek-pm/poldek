    try_uninstall "--greedy a" "a-1-1,b-1-1"
}

testUninstallGreedyBooleanVersion() {
    build_installed k 1-1 -r /bin/sh
    build_installed b 1-1
    build_installed b 2-1
    build_installed a 1-1 -r "'(b >= 1 with b < 2)'"
    try_uninstall "--greedy a" "a-1-1,b-1-1"
}

testUninstallGreedyBooleanPath() {
    build_installed k 1-1 -r /bin/sh
    build_installed b 1-1 -f /opt/zzgreedy/tool
    build_installed a 1-1 -r "'(/opt/zzgreedy/tool or zzmissing)'"
    try_uninstall "--greedy a" "a-1-1,b-1-1"
}

# ... unless another package still needs it, through a boolean requirement too
testUninstallGreedyBooleanShared() {
    build_installed k 1-1 -r /bin/sh
    build_installed b 1-1 -p bcap
    build_installed a 1-1 -r "'(b with bcap)'"
    build_installed c 1-1 -r "'(b or zzmissing)'"
    try_uninstall "--greedy a" "a-1-1"
}

# the message names the package whose removal broke the requirement: q, with
# a path in Provides:, not a, the provider of the excluded y
testUninstallMarkedByCulprit() {
    build_installed a 1-1 -p y
    build_installed q 1-1 -p /usr/bin/zzvirtual
    build_installed b 1-1 -r "'(/usr/bin/zzvirtual without y)'"

    local dest="--dt dir --destination $DESTINATION_REPO"
    [ "$INSTALL_MODE" = "rpm" ] && dest="--root $DESTINATION_REPO"
    local out=$($RAW_POLDEK $dest --noask -ev --test a q 2>&1)
    echo "$out" | grep -q 'q-1-1.* marks b-1-1' || fail "b not marked by q: $out"

    try_uninstall "a q" "a-1-1,q-1-1,b-1-1"
}

testUninstallAndWith() {
    # an unsatisfiable with-conjunct makes the whole and unsatisfiable
    build_installed a 1-1
    build_installed w 1-1 -p x -p y
    build_installed b 1-1 -r "'(a and (x with y))'"
    try_uninstall w "w-1-1,b-1-1"
}

testUninstallOrUnionInWith() {
    # or inside with must union providers (set semantics), not pick a branch
    build_installed w 1-1 -p x -p y
    build_installed p 1-1 -p x -p z
    build_installed q 1-1 -p y
    build_installed b 1-1 -r "'(x with (y or z))'"
    try_uninstall w "w-1-1"
}

testUninstallIfCondition() {
    # removing a plain if-condition only weakens the requirement
    build_installed a 1-1
    build_installed c 1-1
    build_installed b 1-1 -r "'(a if c)'"
    try_uninstall c "c-1-1"
}

testUninstallIfElseSatisfied() {
    build_installed a 1-1
    build_installed c 1-1
    build_installed d 1-1
    build_installed b 1-1 -r "'(a if c else d)'"
    try_uninstall c "c-1-1"
}

testUninstallIfElseBroken() {
    build_installed a 1-1
    build_installed c 1-1
    build_installed b 1-1 -r "'(a if c else d)'"
    try_uninstall c "c-1-1,b-1-1"
}

. ./sh/lib/shunit2
