# a path counts as provided by a Provides: of it, not only by owning the file
testUninstallOrPathProvided() {
    build_installed p 1-1 -p /usr/bin/zzx
    build_installed q 1-1 -f /usr/bin/zzx
    build_installed d 1-1 -r "'(/usr/bin/zzx or zzc)'"
    try_uninstall q "q-1-1"
}

# the remaining owner of a path counts whatever file lists the session loaded
testUninstallOrPathOwnerAfterRepoLoad() {
    build_installed a 1-1
    build_installed c 1-1 -f /opt/zzrev/file
    build_installed b 1-1 -r "'(a or /opt/zzrev/file)'"
    build zzother 1-1

    local dest="--dt dir --destination $DESTINATION_REPO"
    [ "$INSTALL_MODE" = "rpm" ] && dest="--root $DESTINATION_REPO"
    local out=$($RAW_POLDEK --st dir -s $REPO $dest --noask --cmd "ls; uninstall --test a" 2>&1)
    echo "$out" | grep -q 'marks b-1-1' && fail "b marked although c still owns the path"

    try_uninstall a "a-1-1"
}

# the message names the package whose removal broke the requirement: q, with
# a path in Provides:, not a, the provider of the excluded y
testUninstallMarkedByCulprit() {
    build_installed a 1-1 -p y
    build_installed q 1-1 -p /usr/bin/zzvirtual
    build_installed b 1-1 -r "'(/usr/bin/zzvirtual without y)'"

    local dest="--dt dir --destination $DESTINATION_REPO"
    [ "$INSTALL_MODE" = "rpm" ] && dest="--root $DESTINATION_REPO"
    local out=$($RAW_POLDEK $dest --noask -ev --test a q 2>&1)
    echo "$out" | grep -q 'q-1-1.* marks b-1-1' || fail "b not marked by q: $out"

    try_uninstall "a q" "a-1-1,q-1-1,b-1-1"
}

testUninstallAndWith() {
