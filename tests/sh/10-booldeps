# uninstall side: erase must cascade over packages whose boolean requirement
# stops being satisfiable, and leave the rest alone

try_uninstall() {
    if [ "$INSTALL_MODE" = "rpm" ]; then
        rpm_uninstall "$@"
    else
        try_uninstall_package "dir" "-ev --test" "$@"
    fi
}

# usage: rpm_uninstall <package> <expected removed NVRs>
# rpm itself rejects an erase that leaves a dependency broken
rpm_uninstall() {
    is_rpm_testing_off && return

    typeset package="$1"
    typeset removed=$(echo $2 | sed 's/,/ /g')
    typeset installed=$($RPM -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}\n')

    $RAW_POLDEK --root $DESTINATION_REPO --justdb -ev $package
    assertEquals "erase failed" "$?" "0"

    for i in $installed; do
        if echo " $removed " | grep -q " $i "; then
            if $RPM --quiet -q $i; then fail "$i: package expected to be removed"; fi
        else
            if ! $RPM --quiet -q $i; then fail "$i: package expected to be kept"; fi
        fi
    done
}

