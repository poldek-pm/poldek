# c provides x as well as y, so after a goes nothing provides x without y
testUninstallWithout() {
    build_installed a 1-1 -p x
    build_installed c 1-1 -p x -p y
    build_installed b 1-1 -r "'(x without y)'"
    try_uninstall a "a-1-1,b-1-1"
}

