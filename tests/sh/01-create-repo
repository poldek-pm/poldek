#!/bin/sh
# $Id$

# --mkidx tests
. ./sh/lib/setup
. ./sh/lib/repo-setup
. ./sh/lib/compr-setup
. ./sh/lib/rpm-setup

setUp() {
    #repo_up
    sudo_up
}

# preloaded into poldek to make the close of a file fail
CLOSE_ERROR_SO="$PWD/.libs/close_error.so"

#  Index creation use cases:
Case_a="-s /foo                   =>  dir  -> default type"
Case_b="--st type -s /foo         =>  type -> default type"
#Case_c="--st type /foo --mt dtype =>  type -> dtype" # irrelevant, as pndir is only creatable format
#Case_d="-s /foo --mt dtype        =>  dir  -> dtype" # irrelevant, as pndir is only creatable format
#Case_e="-s /foo --mt dtype,dtype2 =>  dir  -> dtype" # irrelevant, as pndir is only creatable format
Case_f="-n foo                    =>  dir (or original type) -> foo's type"
Case_g="-s /foo --mkidx=<path>    =>  index written outside the repo"
Case_h="-n foo --mkidx=<path>     =>  the same, with an explicit index name"


testCreateDefaultType()
{
    msgn $Case_a
    $POLDEK_NOCONF -s $REPO --mkidx || fail "mkidx #1 failed"
    die_if_empty_index "$REPO/packages.ndir$COMPR_EXT"

    $POLDEK_NOCONF -s $REPO --mkidx=$TMPDIR || fail "mkidx #2 failed"
    die_if_empty_index "$TMPDIR/packages.ndir$COMPR_EXT"
    if ! diff -u $REPO/packages.ndir.md $TMPDIR/packages.ndir.md; then
        fail "differ md's!"
    fi
}

#  b) --st dir -s /foo          =>  dir -> default type
testCreateFromDir()
{
    $POLDEK_NOCONF --st dir -s $REPO --index || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.ndir$COMPR_EXT"

    # move indexes to separate dir to make sure poldek will not faillback to load it as "dir" repo
    rm -rf $TMPDIR/tmprepo
    mkdir $TMPDIR/tmprepo
    mv $REPO/packages.ndir* $TMPDIR/tmprepo || fail "cp failed"

    check_repo_content $TMPDIR/tmprepo
}

# the descriptions (changelogs) are saved next to the index also when the path has a '%'
testCreateInDirWithPercent()
{
    local repo="$TMPDIR/re%20dpo"

    rm -rf $repo
    mkdir $repo
    cp $REPO/*.rpm $repo || fail "cp failed"

    $POLDEK_NOCONF --st dir -s $repo --index || fail "mkidx failed"
    die_if_empty_index "$repo/packages.ndir$COMPR_EXT"
    check_repo_content $repo
}

# an index that could not be written fails --mkidx and gets no digest
testCreateWriteError()
{
    local dir="$TMPDIR/write-error"

    rm -rf $dir
    mkdir $dir
    # with SIGXFSZ ignored, a write past the file size limit fails instead of killing poldek
    if (trap '' XFSZ; ulimit -f 1; $POLDEK_NOCONF -s $REPO --mkidx=$dir); then
        fail "mkidx succeeded"
    fi
    [ ! -f "$dir/packages.ndir.md" ] || fail "digest of an unwritten index"
}

# descriptions that could not be written fail --mkidx too, though the index was
testCreateDescrWriteError()
{
    local dir="$TMPDIR/descr-write-error"

    rm -rf $dir
    # the descriptions cannot replace a directory of their name
    mkdir -p $dir/packages.ndir.dscr$COMPR_EXT
    if $POLDEK_NOCONF -s $REPO --mkidx=$dir; then
        fail "mkidx succeeded"
    fi
    die_if_empty_index "$dir/packages.ndir$COMPR_EXT"
    [ ! -f "$dir/packages.ndir.md" ] || fail "digest of unwritten descriptions"
}

# a diff whose descriptions could not be written is not listed for the clients
testCreateDiffWriteError()
{
    local repo="$TMPDIR/write-error-diff"
    local last=$(ls $REPO/*.rpm | tail -1)
    local dscr

    rm -rf $repo $repo.copy
    mkdir $repo
    cp $REPO/*.rpm $repo || fail "cp failed"
    rm -f $repo/$(basename $last)
    $POLDEK_NOCONF -s $repo --mkidx || fail "mkidx failed"
    cp $last $repo || fail "cp failed"

    # a diff's files are named after the time of the index it follows, so a
    # run on a copy tells the name of the diff's descriptions
    cp -a $repo $repo.copy
    $POLDEK_NOCONF -s $repo.copy --mkidx || fail "mkidx of the copy failed"
    dscr=$(cd $repo.copy && ls packages.i/packages.ndir.dscr.[0-9]*)
    [ -n "$dscr" ] || fail "no descriptions in the diff"

    mkdir -p $repo/$dscr
    if $POLDEK_NOCONF -s $repo --mkidx; then
        fail "mkidx succeeded"
    fi
    [ ! -f "$repo/packages.i/packages.ndir.diff.toc$COMPR_EXT" ] || fail "diff with unwritten descriptions listed"
}

# a diff whose list of diffs the clients read could not be written fails too
testCreateDiffTocWriteError()
{
    local repo="$TMPDIR/write-error-toc"
    local last=$(ls $REPO/*.rpm | tail -1)

    rm -rf $repo
    mkdir $repo
    cp $REPO/*.rpm $repo || fail "cp failed"
    rm -f $repo/$(basename $last)
    $POLDEK_NOCONF -s $repo --mkidx || fail "mkidx failed"
    cp $last $repo || fail "cp failed"

    # a directory cannot replace packages.ndir.diff.toc<comp>
    mkdir -p $repo/packages.i/packages.ndir.diff.toc$COMPR_EXT
    if $POLDEK_NOCONF -s $repo --mkidx; then
        fail "mkidx succeeded"
    fi
}

# a digest whose close failed fails --mkidx; its bytes are written from the
# close of a stdio stream, so nothing else could report the bad write
testCreateDigestCloseError()
{
    local dir="$TMPDIR/digest-close-error" out rc

    rm -rf $dir
    mkdir $dir
    out=$(env LC_ALL=C LD_PRELOAD=$CLOSE_ERROR_SO WRITE_ERROR=packages.ndir.md \
        $POLDEK_NOCONF -s $REPO --mkidx=$dir 2>&1)
    rc=$?
    assertTrue "mkidx succeeded: $out" "[ $rc -ne 0 ]"
    assertTrue "no cause given: $out" "echo \"$out\" | grep -q 'unable to write digest: No space left on device'"
    die_if_empty_index "$dir/packages.ndir$COMPR_EXT"
    [ ! -f "$dir/packages.ndir.md" ] || fail "digest of a failed write"
}

# a list of diffs whose close failed fails --mkidx and is not left cut
testCreateDiffTocCloseError()
{
    local repo="$TMPDIR/close-error-toc"
    local last=$(ls $REPO/*.rpm | tail -1)

    rm -rf $repo
    mkdir $repo
    cp $REPO/*.rpm $repo || fail "cp failed"
    rm -f $repo/$(basename $last)
    $POLDEK_NOCONF -s $repo --mkidx || fail "mkidx failed"
    cp $last $repo || fail "cp failed"

    if env LD_PRELOAD=$CLOSE_ERROR_SO WRITE_ERROR=packages.ndir.diff.toc$COMPR_EXT \
        $POLDEK_NOCONF -s $repo --mkidx; then
        fail "mkidx succeeded"
    fi
    [ ! -f "$repo/packages.i/packages.ndir.diff.toc$COMPR_EXT" ] || fail "cut list of diffs left"
}

#  b) --st rpmdb -s /foo          =>  rpmdb -> default type
testCreateFromRpmdb() {
    skip_if_rpm_testing_off && return

    rm -rf $TMPDIR/tmproot
    mkdir $TMPDIR/tmproot
    $SUDO rpm --root=$TMPDIR/tmproot --initdb

    local rpmop=
    test is_verbose_mode && rpmop="v"

    msgn "prep: rpm install"
    $SUDO rpm --root=$TMPDIR/tmproot -U$rpmop $SOURCE_REPO/sh-*.rpm --noscripts
    for p in $(ls $SOURCE_REPO/a*.rpm); do
        $SUDO rpm --root=$TMPDIR/tmproot -U$rpmop $p --noscripts
    done

    msgn "test"
    $POLDEK_NOCONF --st rpmdb -s $TMPDIR/tmproot/var/lib/rpm --index=$TMPDIR/tmproot/packages.ndir$COMPR_EXT || fail "mkidx failed"
    die_if_empty_index "$TMPDIR/tmproot/packages.ndir$COMPR_EXT"
    check_repo_content $TMPDIR/tmproot
}

#  d) -s /foo --mt dtype        =>  dir  -> dtype
#  e) -s /foo --mt dtype,dtype2 =>  dir  -> dtype
xtestSelectType() # disabled as pdir indexes are gone since 0.4
{
    msgn "$Case_d"
    $POLDEK_NOCONF -s $REPO --mkidx --mt pdir || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.dir$COMPR_EXT"

    rm -rf $REPO/packages.*
    $POLDEK_NOCONF -s $REPO --st dir --mkidx --mt pdir || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.dir$COMPR_EXT"

    setUp

    msgn "$Case_e"
    $POLDEK_NOCONF -s $REPO --mkidx --mt pdir,pndir || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.ndir$COMPR_EXT"
    die_if_empty_index "$REPO/packages.dir$COMPR_EXT"
}

poldek_n() {
    $POLDEK_NOCONF -Osource1="repo-pndir,type=pndir $REPO"  $@
}

#  f) -n foo                    =>  dir (or original type) -> foo's type
testCreateByName()
{
    msgn "$Case_f"
    poldek_n -n repo-pndir --mkidx || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.ndir$COMPR_EXT"
}

#  g) -s /foo --mkidx=<path>
testNonDefaultName()
{
    msgn "$Case_g"
    poldek="$POLDEK_NOCONF"

    msgn "1"
    $poldek -s $REPO --mkidx=$TMPDIR || fail "mkidx #1 failed"
    die_if_empty_index "$TMPDIR/packages.ndir$COMPR_EXT"

    msgn "2"
    $poldek -s $REPO --mkidx=$TMPDIR/packages.foo.ndir$COMPR_EXT || fail "mkidx #2 failed"
    die_if_empty_index "$TMPDIR/packages.foo.ndir$COMPR_EXT"

    msgn "3"
    $poldek --st pndir -s $TMP/packages.foo.ndir$COMPR_EXT \
            --mkidx=$TMP/packages.foo2.ndir$COMPR_EXT --mt pndir || fail "mkidx #3 failed"

    die_if_empty_index "$TMP/packages.foo2.ndir$COMPR_EXT"

    setUp
    msgn "4"
    $poldek -s $REPO --mkidx --mt pndir || fail "mkidx #4 failed"

    msgn "5"
    poldek="$POLDEK_UP -Ovfile_retries=1"
    $poldek --st pndir -s $REPOURL --mkidx=$TMPDIR || fail "mkidx #5 failed"
    die_if_empty_index "$TMPDIR/packages.ndir$COMPR_EXT"

    msgn "6"
    $poldek --st pndir -s $REPOURL --mkidx=$TMPDIR/packages.foo.ndir$COMPR_EXT || fail "mkidx #6 failed"
    die_if_empty_index "$TMPDIR/packages.foo.ndir$COMPR_EXT"
}

#  h) -n foo --mkidx=<path>
testCreateFromRemoteRepos()
{
    msgn "$Case_h"
    poldek_n -n repo-pndir --mkidx=$TMPDIR/packages.foo.ndir$COMPR_EXT --mt pndir ||
        fail "mkidx #1 failed"
    die_if_empty_index "$TMPDIR/packages.foo.ndir$COMPR_EXT"

    poldek_n -n repo-pndir --mkidx=$TMPDIR/packages.foo2.ndir$COMPR_EXT --mt pndir ||
        fail "mkidx #2 failed"

    die_if_empty_index "$TMPDIR/packages.foo2.ndir$COMPR_EXT"
}

# a merged index from several sources is not written when one fails to load
testCreateMergedWithMissingSource()
{
    msgn "--st dir -s /missing --st dir -s /foo --mkidx=<path>"
    rm -rf $TMPDIR/merged
    mkdir $TMPDIR/merged

    # sources go in path order, so the missing one is loaded first
    $POLDEK_NOCONF --st dir -s $TMPDIR/missing --st dir -s $REPO --mkidx=$TMPDIR/merged &&
        fail "mkidx with a missing source succeeded"
    [ -z "$(ls $TMPDIR/merged)" ] || fail "index written: $(ls $TMPDIR/merged)"
}

testCreateConfiguredDefaultIndexCompr()
{
    msgn "with 'default index compr' = zst"
    echo "
[global]
default index compr = zst
" >> $TMPDIR/poldek.conf

    if [ -n "$POLDEK_TESTING_INDEX_COMPR" ]; then # unset global
        force_msg " => compression is set globally, skipped"
        return;
    fi

    $POLDEK --conf $TMPDIR/poldek.conf -s $REPO --mkidx || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.ndir.zst"
}

testCreateWithIndexComprOption()
{
    compr="$POLDEK_TESTING_INDEX_COMPR"
    if [ -n "$POLDEK_TESTING_INDEX_COMPR" ]; then # unset global
        unset POLDEK_TESTING_INDEX_COMPR
    fi

    op=""
    if [ "$compr" == "zst" ]; then
        op="zstd"
    elif [ "$compr" == "gz" ]; then
        op="gzip"
    elif [ "$compr" == "none" ]; then
        op="nocompress"
    else
        op="gzip"
    fi

    msgn "with --mo=$op"

    $POLDEK_NOCONF -s $REPO --mkidx --mo=$op || fail "mkidx failed"
    die_if_empty_index "$REPO/packages.ndir$COMPR_EXT"
}

# poldek stops when rpm cannot read its configuration, instead of going on
# with an unconfigured rpm and the umask the failed read left at 0
testCreateWithoutRpmConfig()
{
    local dir=$TMPDIR/no-rpm-config out rc

    rm -rf $dir && mkdir $dir || fail "mkdir failed"
    out=$(umask 077; RPM_CONFIGDIR=$dir/none $POLDEK_NOCONF -s $REPO --mkidx=$dir 2>&1)
    rc=$?
    assertTrue "exit code 0 without rpm configuration: $out" "[ $rc -ne 0 ]"
    assertEquals "files left in $dir" "" "$(ls -A $dir)"
}


. ./sh/lib/shunit2
