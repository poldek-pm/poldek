#!/bin/sh
# packages copied to a --fetch directory or a --destination repository

. ./sh/lib/setup
. ./sh/lib/repo-setup

ORIGREPO=

setUp() {
    [ -z "$ORIGREPO" ] && ORIGREPO=$REPO
    [ -z "$ORIGREPO" ] && fail "empty REPO env variable"
    rm -rf $ORIGREPO/*

    REPO="$ORIGREPO/src"
    DESTINATION_REPO="$ORIGREPO/dest"
    FETCHDIR="$ORIGREPO/fetched"
    mkdir -p $REPO $DESTINATION_REPO $FETCHDIR || fail "mkdir failed"

    build_package $REPO a
    # provide /bin/sh auto requirement
    build_package $DESTINATION_REPO sh -p /bin/sh
    POLDEK_INSTALL="$POLDEK_NOCONF --st dir -s $REPO --dt dir --destination $DESTINATION_REPO"
}

# cp refuses to write through a dangling symlink
block_copy_to() {
    ln -s $ORIGREPO/nothing-here $1/a-1-1.noarch.rpm || fail "ln failed"
}

testFetch() {
    $POLDEK_INSTALL -i --fetch=$FETCHDIR a
    assertEquals "fetch failed" "0" "$?"
    assertTrue "a not fetched" "[ -f $FETCHDIR/a-1-1.noarch.rpm ]"
}

testFetchCopyFails() {
    block_copy_to $FETCHDIR
    $POLDEK_INSTALL -i --fetch=$FETCHDIR a
    rc=$?
    assertTrue "a failed copy ended with exit code 0" "[ $rc -ne 0 ]"
}

testDestination() {
    $POLDEK_INSTALL -i a
    assertEquals "install failed" "0" "$?"
    assertTrue "a not copied" "[ -f $DESTINATION_REPO/a-1-1.noarch.rpm ]"
}

testDestinationCopyFails() {
    block_copy_to $DESTINATION_REPO
    $POLDEK_INSTALL -i a
    rc=$?
    assertTrue "a failed copy ended with exit code 0" "[ $rc -ne 0 ]"
}

# of two packages that differ only in arch, the one for this machine is
# copied; it comes from the first source, and without rpm's scores the
# arch poldek sees last would win
testDestinationPrefersMachineArch() {
    local arch=$(uname -m) foreign=$ORIGREPO/foreign out

    mkdir -p $foreign || fail "mkdir failed"
    build_package $REPO b 1-1 -a $arch -f /b.$arch
    build_package $foreign b 1-1 -a xtensa -f /b.xtensa
    # outside test mode, so nothing test-only can set rpm up instead
    out=$(env -u POLDEK_TESTING $POLDEK_INSTALL --st dir -s $foreign -i b 2>&1)
    assertEquals "install failed: $out" "0" "$?"
    assertTrue "b for $arch not copied: $out" "[ -f $DESTINATION_REPO/b-1-1.$arch.rpm ]"
    assertFalse "b for xtensa copied" "[ -e $DESTINATION_REPO/b-1-1.xtensa.rpm ]"
}

testDestinationWithoutRpmConfig() {
    local out rc

    out=$(RPM_CONFIGDIR=$ORIGREPO/no-rpm-config $POLDEK_INSTALL -i a 2>&1)
    rc=$?
    assertTrue "exit code 0 without rpm configuration: $out" "[ $rc -ne 0 ]"
    assertFalse "a copied" "[ -e $DESTINATION_REPO/a-1-1.noarch.rpm ]"
}

. ./sh/lib/shunit2
