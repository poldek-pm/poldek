# A repos.d file may define no source at all; listing it must neither crash
# nor hide it
testRepoLsEmptyConfiguration()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/empty.conf <<EOF
[global]
foo = bar
EOF

    out=$($POLDEK repo ls 2>&1)
    assertEquals "repo ls of an empty configuration failed" "0" "$?"
    echo "$out" | grep -qx "empty.conf (no sources)" || \
        fail "the empty repository not listed: $out"
}

# A source name can also come from a global `source = ...` line, where there
# is no file to name; adding a repository with such a name is refused (the
# configuration would not load afterwards) and the configuration keeps
# working
testRepoAddDuplicateNameOfLegacySource()
{
    local tmp=${TMPDIR:-/tmp}
    local home=$tmp/home-legacy
    local out

    export POLDEK_TESTING_REPOSDIR=$REPOSD
    rm -rf $home
    mkdir -p $home

    cat > $home/.poldekrc <<EOF
[global]
cachedir = $home/cache
source = poldekrepo-test-src,type=pndir /nonexistent/legacy/
EOF

    out=$(HOME=$home $POLDEK repo add $REMOTE_CONF 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a source name taken by a [global] source line should be refused"
    fi
    echo "$out" | grep -q "already defined in \[global\]" || \
        fail "the [global] owner not named: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected" "0" "$n"

    HOME=$home $POLDEK -l > /dev/null 2>&1
    assertEquals "the configuration should still load" "0" "$?"
}

testRepoBaseUrlMacro()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD
    SHLIBDIR="$PWD/sh/lib"
    CACHEDIR=${TMPDIR:-/tmp}/poldek-cache
    rm -rf $CACHEDIR
    mkdir -p $CACHEDIR

    cat > $REMOTE_CONF <<EOF
[source]
name = baseurl-test-src
path = %{_baseurl}/%{_arch}/
type = pndir
EOF

    POLDEK_TESTING_PRELOAD_CONF="$SHLIBDIR/vftest-fetch.conf"
    export POLDEK_TESTING_PRELOAD_CONF
    PATH="$PATH:$SHLIBDIR"
    export PATH

    msg $POLDEK --cachedir $CACHEDIR repo add test:/$REMOTE_CONF
    run_poldek $POLDEK --cachedir $CACHEDIR repo add test:/$REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    grep -q "^_baseurl = " $fn || fail "missing _baseurl macro in saved file"
    grep -q "^_origin = " $fn || fail "missing _origin macro in saved file"
    grep -q "^__dirname = " $fn && fail "internal __dirname macro leaked into saved file"
    grep -q '^path = %{_baseurl}' $fn || fail "path should keep %{_baseurl} macro in saved file"
    grep -qE '^path = /' $fn && fail "path was expanded to absolute local path in saved file"
    grep -q '^auto = no$' $fn || fail "missing auto = no in saved file"

    # a long path is shortened in the listing unless the width is known: the
    # path below is whatever TMPDIR the run got, so keep it from being elided
    out=$(env COLUMNS=500 $POLDEK --cachedir $CACHEDIR repo ls 2>&1)

    echo "$out" | grep -q "baseurl-test-src" || fail "source not listed: $out"
    echo "$out" | grep -q "test:/$REMOTE_CONF" || fail "_origin URL not listed: $out"

    local arch=$(rpm --eval '%{_target_cpu}')
    echo "$out" | grep -q "test:/$(dirname $REMOTE_CONF)/$arch/" || fail "expanded path not listed: $out"
}

# A URL may carry a password; the file name must be derived from it all
# the same, with the credentials left out of it
testRepoAddWithPassword()
{
    local out fn shown
    export POLDEK_TESTING_REPOSDIR=$REPOSD
    SHLIBDIR="$PWD/sh/lib"
    CACHEDIR=${TMPDIR:-/tmp}/poldek-cache
    rm -rf $CACHEDIR
    mkdir -p $CACHEDIR

    POLDEK_TESTING_PRELOAD_CONF="$SHLIBDIR/vftest-fetch.conf"
    export POLDEK_TESTING_PRELOAD_CONF
    PATH="$PATH:$SHLIBDIR"
    export PATH

    out=$($POLDEK --cachedir $CACHEDIR repo add \
              "cred://user:secret@$REMOTE_CONF" 2>&1)
    assertEquals "repo add of a URL with a password failed: $out" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    case "$fn" in
        *secret*) fail "the password is a part of the file name: $fn" ;;
    esac

    grep -q '^name = poldekrepo-test-src$' $fn || \
        fail "source not saved: $(cat $fn)"

    out=$($POLDEK --cachedir $CACHEDIR repo ls 2>&1)
    echo "$out" | grep -q "poldekrepo-test-src" || \
        fail "source not listed: $out"
    echo "$out" | grep -q "secret" && \
        fail "the password is shown by repo ls: $out"

    # the password is no name, the URL as repo ls shows it is
    out=$($POLDEK repo del secret 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "repo del by the password should remove nothing"
    fi
    shown=$($POLDEK --cachedir $CACHEDIR repo ls 2>&1 | grep -o '^cred://[^ ]*')
    out=$($POLDEK repo del "$shown" 2>&1)
    assertEquals "repo del by the URL as repo ls shows it ($shown) failed: $out" "0" "$?"
    return 0
}

