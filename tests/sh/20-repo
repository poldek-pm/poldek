# A repository is named by the beginning of its URL's last part or of a
# source's name; one that begins more than one, or a part of the URL
# elsewhere, removes nothing
testRepoDeleteByName()
{
    local tmp=${TMPDIR:-/tmp}
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $tmp/repo-frag-a.conf <<EOF
[source]
name = frag-a-src
path = http://example.com/frag/a
type = pndir
EOF

    cat > $tmp/repo-frag-b.conf <<EOF
[source]
name = frag-b-src
path = http://example.com/frag/b
type = pndir
EOF

    run_poldek $POLDEK repo add $tmp/repo-frag-a.conf
    assertEquals "repo add a failed" "0" "$?"
    run_poldek $POLDEK repo add $tmp/repo-frag-b.conf
    assertEquals "repo add b failed" "0" "$?"

    out=$($POLDEK repo del repo-frag- 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a name of more than one repo should remove nothing"
    fi
    echo "$out" | grep -q "matches 2 repositories" || \
        fail "the ambiguity not named: $out"
    echo "$out" | grep -q "$tmp/repo-frag-a.conf" || \
        fail "the first repository not listed: $out"
    echo "$out" | grep -q "$tmp/repo-frag-b.conf" || \
        fail "the second repository not listed: $out"

    out=$($POLDEK repo del frag-a.conf 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a part of the URL should remove nothing"
    fi
    echo "$out" | grep -q "frag-a.conf: not a URL or name of a repository, a part of:" || \
        fail "a part of the URL not refused: $out"
    echo "$out" | grep -q "^  $tmp/repo-frag-a.conf$" || \
        fail "the repository it is a part of not listed: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "both repositories expected to stay" "2" "$n"

    out=$($POLDEK repo del frag-a-s 2>&1)
    assertEquals "repo del by the beginning of a source name failed: $out" "0" "$?"
    echo "$out" | grep -q "$tmp/repo-frag-a.conf: repository removed (1 source)" || \
        fail "the removed repository's origin not named: $out"

    out=$($POLDEK repo ls 2>&1)
    echo "$out" | grep -q "frag-b-src" || fail "the other repository is gone: $out"
    echo "$out" | grep -q "frag-a-src" && fail "the removed repository is listed: $out"

    out=$($POLDEK repo del repo-frag-b 2>&1)
    assertEquals "repo del by the beginning of the URL's last part failed: $out" "0" "$?"
    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no repository expected to stay" "0" "$n"
    return 0
}

