#!/bin/sh
# $Id$

# repo command tests

. ./sh/lib/setup

POLDEK="$PWD/../cli/poldek"
$POLDEK --version >/dev/null 2>&1

REPOSD=
REMOTE_CONF=
INVALID_CONF=

setUp() {
    local tmp=${TMPDIR:-/tmp}
    REPOSD=$tmp/reposd-19
    REMOTE_CONF=$tmp/remote-19.conf
    INVALID_CONF=$tmp/invalid-19.conf

    rm -rf $REPOSD
    mkdir -p $REPOSD

    cat > $REMOTE_CONF <<EOF
[source]
name = poldekrepo-test-19
path = http://example.com/poldek
type = pndir
EOF

    cat > $INVALID_CONF <<EOF
[source]
name = invalid-test-19
path = http://example.com/invalid
foo = bar
EOF
}

testRepoAddListDelete()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "one managed .conf expected" "1" "$n"

    out=$($POLDEK repo ls)
    echo "$out" | grep -q "poldekrepo-test-19" || \
        fail "repo ls does not show the added source: $out"

    fn=$(basename $(ls $REPOSD/*.conf))
    $POLDEK repo del $fn
    assertEquals "repo del failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no managed .conf expected after delete" "0" "$n"
}

testRepoOverwrite()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo add $REMOTE_CONF
    assertEquals "first repo add failed" "0" "$?"

    $POLDEK repo add $REMOTE_CONF
    if [ "$?" -eq 0 ]; then
        fail "second repo add should fail without --force"
    fi

    $POLDEK repo add $REMOTE_CONF --force
    assertEquals "repo add --force failed" "0" "$?"

    $POLDEK repo --force add $REMOTE_CONF
    assertEquals "repo --force add failed" "0" "$?"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "one managed .conf expected after overwrite" "1" "$n"
}

testRepoInvalidRejected()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    $POLDEK repo add $INVALID_CONF
    if [ "$?" -eq 0 ]; then
        fail "repo add with invalid config should fail"
    fi

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected after rejected add" "0" "$n"
}

