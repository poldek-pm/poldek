# A .repo without an enabled baseurl, or a broken one, is refused
testRepoAddDnfRepoInvalid()
{
    local tmp=${TMPDIR:-/tmp}
    local n out
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $tmp/dnf-bad-19
    mkdir -p $tmp/dnf-bad-19

    cat > $tmp/dnf-bad-19/metalink.repo <<EOF
[bad-19]
metalink = https://example.com/metalink?repo=bad
EOF

    out=$($POLDEK repo add $tmp/dnf-bad-19/metalink.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a metalink-only .repo should fail"
    fi
    echo "$out" | grep -q "not supported" || fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected" "0" "$n"

    printf '[broken-19]\nbaseurl\n' > $tmp/dnf-bad-19/broken.repo
    out=$($POLDEK repo add $tmp/dnf-bad-19/broken.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a broken .repo should fail"
    fi
    echo "$out" | grep -q "missing '='" || fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected after a broken .repo" "0" "$n"
}

# A repository id with a character dnf does not allow is a fatal error
testRepoAddDnfRepoBadId()
{
    local tmp=${TMPDIR:-/tmp}
    local n out fn
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $tmp/dnf-id-19
    mkdir -p $tmp/dnf-id-19

    printf '[bad id-19]\nbaseurl = http://example.com/space/\n' \
        > $tmp/dnf-id-19/space.repo

    out=$($POLDEK repo add $tmp/dnf-id-19/space.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a .repo with a space in an id should fail"
    fi
    echo "$out" | grep -q "invalid repository id 'bad id-19'" || \
        fail "a space in an id not reported: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected" "0" "$n"

    printf '[bad#id-19]\nbaseurl = http://example.com/hash/\n' \
        > $tmp/dnf-id-19/hash.repo

    out=$($POLDEK repo add $tmp/dnf-id-19/hash.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a .repo with a '#' in an id should fail"
    fi
    echo "$out" | grep -q "invalid repository id 'bad#id-19'" || \
        fail "a '#' in an id not reported: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "still no .conf expected" "0" "$n"

    printf '[good.id:X-19]\nbaseurl = http://example.com/allowed/\n' \
        > $tmp/dnf-id-19/good.repo

    out=$($POLDEK repo add $tmp/dnf-id-19/good.repo 2>&1)
    assertEquals "repo add failed" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    grep -q '^name = good.id:X-19$' $fn || \
        fail "dnf's allowed id characters rejected: $(cat $fn)"

    return 0
}

# A URL with no directory part must not crash; a relative baseurl is
# then resolved against the current directory
testRepoAddRelativePath()
{
    local tmp=${TMPDIR:-/tmp}
    local out fn dir
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $tmp/dnf-rel-19
    mkdir -p $tmp/dnf-rel-19
    dir=$(cd $tmp/dnf-rel-19 && pwd -P)

    printf '[rel-19]\nbaseurl = sub/dir/\n' > $tmp/dnf-rel-19/dnfrel.repo
    out=$(cd $tmp/dnf-rel-19 && $POLDEK repo add dnfrel.repo 2>&1)
    assertEquals "repo add of a relative .repo failed: $out" "0" "$?"

    fn=$REPOSD/dnfrel.conf
    grep -q "^_baseurl = $dir$" $fn || \
        fail "_baseurl is not the .repo directory: $(cat $fn)"
    grep -q "^path = $dir/sub/dir/$" $fn || \
        fail "a relative baseurl is not resolved against the .repo: $(cat $fn)"

    printf '[source]\nname = confrel-19\npath = http://example.com/x/\ntype = metadata\n' \
        > $tmp/dnf-rel-19/confrel.conf
    out=$(cd $tmp/dnf-rel-19 && $POLDEK repo add confrel.conf 2>&1)
    assertEquals "repo add of a relative .conf failed: $out" "0" "$?"

    fn=$REPOSD/confrel.conf
    grep -q '^_baseurl = \.$' $fn || \
        fail "_baseurl is not '.' for a .conf: $(cat $fn)"

    return 0
}

# Sources from the built-in repos.d are listed after the user's and
# flagged as managed
testRepoManagedSourcesListed()
{
    local tmp=${TMPDIR:-/tmp}
    local home=$tmp/home-19
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $home
    mkdir -p $home

    cat > $home/.poldekrc <<EOF
[global]
cachedir = $home/cache

[source]
name = plain-test-19
path = $tmp/plain-19/
type = pndir
EOF

    $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    out=$(HOME=$home $POLDEK up -l 2>&1)
    assertEquals "up -l failed" "0" "$?"

    echo "$out" | grep -q '^plain-test-19 ' || fail "user source not listed: $out"
    echo "$out" | grep -q 'poldekrepo-test-19.*(managed' || \
        fail "managed source not flagged: $out"

    plain=$(echo "$out" | grep -n 'plain-test-19' | cut -d: -f1)
    managed=$(echo "$out" | grep -n 'poldekrepo-test-19' | cut -d: -f1)
    if [ -n "$plain" ] && [ -n "$managed" ] && [ "$managed" -le "$plain" ]; then
        fail "managed sources should be listed last: $out"
    fi
}

testRepoGlobalIgnored()
{
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $REPOSD/global-poison.conf <<EOF
# remote repository managed by poldek http://example.com/poison
[global]
source = global-hijack,compr=zst /nonexistent/repo/

[source]
name = managed-test-19
path = /nonexistent/repo/
type = pndir
EOF

    out=$($POLDEK -l 2>&1)
    echo "$out" | grep -q "global-hijack" && \
        fail "[global] from repos.d should be ignored, but global-hijack was listed: $out"

    echo "$out" | grep -q "managed-test-19" || \
        fail "managed-test-19 source not listed: $out"
}

