# A part of the URL that only one repository has names it too; a part
# that more than one has removes nothing
testRepoDeleteByUrlFragment()
{
    local tmp=${TMPDIR:-/tmp}
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    cat > $tmp/repo-frag-a-19.conf <<EOF
[source]
name = frag-a-19
path = http://example.com/frag/a
type = pndir
EOF

    cat > $tmp/repo-frag-b-19.conf <<EOF
[source]
name = frag-b-19
path = http://example.com/frag/b
type = pndir
EOF

    $POLDEK repo add $tmp/repo-frag-a-19.conf
    assertEquals "repo add a failed" "0" "$?"
    $POLDEK repo add $tmp/repo-frag-b-19.conf
    assertEquals "repo add b failed" "0" "$?"

    out=$($POLDEK repo del repo-frag- 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a fragment of more than one repo should remove nothing"
    fi
    echo "$out" | grep -q "matches 2 repositories" || \
        fail "the ambiguity not named: $out"
    echo "$out" | grep -q "$tmp/repo-frag-a-19.conf" || \
        fail "the first repository not listed: $out"
    echo "$out" | grep -q "$tmp/repo-frag-b-19.conf" || \
        fail "the second repository not listed: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "both repositories expected to stay" "2" "$n"

    out=$($POLDEK repo del frag-a-19 2>&1)
    assertEquals "repo del by a unique fragment failed" "0" "$?"
    echo "$out" | grep -q "$tmp/repo-frag-a-19.conf repo has been removed" || \
        fail "the removed repository's origin not named: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "one repository expected to stay" "1" "$n"

    out=$($POLDEK repo ls 2>&1)
    echo "$out" | grep -q "frag-b-19" || fail "the other repository is gone: $out"
    echo "$out" | grep -q "frag-a-19" && fail "the removed repository is listed: $out"
    return 0
}

