# A .repo without an enabled baseurl, or a broken one, is refused
testRepoAddDnfRepoInvalid()
{
    local tmp=${TMPDIR:-/tmp}
    local n out
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $tmp/dnf-bad
    mkdir -p $tmp/dnf-bad

    cat > $tmp/dnf-bad/metalink.repo <<EOF
[bad-src]
metalink = https://example.com/metalink?repo=bad
EOF

    out=$($POLDEK repo add $tmp/dnf-bad/metalink.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a metalink-only .repo should fail"
    fi
    echo "$out" | grep -q "not supported" || fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected" "0" "$n"

    printf '[broken]\nbaseurl\n' > $tmp/dnf-bad/broken.repo
    out=$($POLDEK repo add $tmp/dnf-bad/broken.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a broken .repo should fail"
    fi
    echo "$out" | grep -q "missing '='" || fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected after a broken .repo" "0" "$n"

    # a line longer than poldek reads (4094 bytes) is refused, not cut
    printf '[long]\nbaseurl = http://example.com/long/\ngpgkey = https://example.com/%s.asc\n' \
        "$(head -c 5000 /dev/zero | tr '\0' k)" > $tmp/dnf-bad/long.repo
    out=$($POLDEK repo add $tmp/dnf-bad/long.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a .repo with a too long line should fail"
    fi
    echo "$out" | grep -q "long.repo:3: line longer than" || fail "no reason given: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected after a too long line" "0" "$n"
}

# A repository id with a character dnf does not allow is a fatal error
testRepoAddDnfRepoBadId()
{
    local tmp=${TMPDIR:-/tmp}
    local n out fn
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $tmp/dnf-id
    mkdir -p $tmp/dnf-id

    printf '[bad id]\nbaseurl = http://example.com/space/\n' \
        > $tmp/dnf-id/space.repo

    out=$($POLDEK repo add $tmp/dnf-id/space.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a .repo with a space in an id should fail"
    fi
    echo "$out" | grep -q "invalid repository id 'bad id'" || \
        fail "a space in an id not reported: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "no .conf expected" "0" "$n"

    printf '[bad#id]\nbaseurl = http://example.com/hash/\n' \
        > $tmp/dnf-id/hash.repo

    out=$($POLDEK repo add $tmp/dnf-id/hash.repo 2>&1)
    if [ "$?" -eq 0 ]; then
        fail "a .repo with a '#' in an id should fail"
    fi
    echo "$out" | grep -q "invalid repository id 'bad#id'" || \
        fail "a '#' in an id not reported: $out"

    n=$(ls $REPOSD/*.conf 2>/dev/null | wc -l)
    assertEquals "still no .conf expected" "0" "$n"

    printf '[good.id:X]\nbaseurl = http://example.com/allowed/\n' \
        > $tmp/dnf-id/good.repo

    out=$($POLDEK repo add $tmp/dnf-id/good.repo 2>&1)
    assertEquals "repo add failed" "0" "$?"

    fn=$(ls $REPOSD/*.conf)
    grep -q '^name = good.id:X$' $fn || \
        fail "dnf's allowed id characters rejected: $(cat $fn)"

    return 0
}

# A URL with no directory part must not crash; a relative baseurl is
# then resolved against the current directory
testRepoAddRelativePath()
{
    local tmp=${TMPDIR:-/tmp}
    local out fn dir
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $tmp/dnf-rel
    mkdir -p $tmp/dnf-rel
    dir=$(cd $tmp/dnf-rel && pwd -P)

    printf '[rel-src]\nbaseurl = sub/dir/\n' > $tmp/dnf-rel/dnfrel.repo
    out=$(cd $tmp/dnf-rel && $POLDEK repo add dnfrel.repo 2>&1)
    assertEquals "repo add of a relative .repo failed: $out" "0" "$?"

    fn=$REPOSD/dnfrel.conf
    grep -q "^_baseurl = $dir$" $fn || \
        fail "_baseurl is not the .repo directory: $(cat $fn)"
    grep -q "^path = $dir/sub/dir/$" $fn || \
        fail "a relative baseurl is not resolved against the .repo: $(cat $fn)"

    printf '[source]\nname = confrel-src\npath = http://example.com/x/\ntype = metadata\n' \
        > $tmp/dnf-rel/confrel.conf
    out=$(cd $tmp/dnf-rel && $POLDEK repo add confrel.conf 2>&1)
    assertEquals "repo add of a relative .conf failed: $out" "0" "$?"

    fn=$REPOSD/confrel.conf
    grep -q '^_baseurl = \.$' $fn || \
        fail "_baseurl is not '.' for a .conf: $(cat $fn)"

    return 0
}

# Sources from the built-in repos.d are listed after the user's and
# flagged as managed
testRepoManagedSourcesListed()
{
    local tmp=${TMPDIR:-/tmp}
    local home=$tmp/home
    export POLDEK_TESTING_REPOSDIR=$REPOSD

    rm -rf $home
    mkdir -p $home

    cat > $home/.poldekrc <<EOF
[global]
cachedir = $home/cache

[source]
name = plain-test-src
path = $tmp/plain/
type = pndir
EOF

    run_poldek $POLDEK repo add $REMOTE_CONF
    assertEquals "repo add failed" "0" "$?"

    out=$(HOME=$home $POLDEK up -l 2>&1)
    assertEquals "up -l failed" "0" "$?"

    echo "$out" | grep -q '^plain-test-src ' || fail "user source not listed: $out"
    echo "$out" | grep -q 'poldekrepo-test-src.*(managed' || \
        fail "managed source not flagged: $out"

    plain=$(echo "$out" | grep -n 'plain-test-src' | cut -d: -f1)
    managed=$(echo "$out" | grep -n 'poldekrepo-test-src' | cut -d: -f1)
    if [ -n "$plain" ] && [ -n "$managed" ] && [ "$managed" -le "$plain" ]; then
        fail "managed sources should be listed last: $out"
    fi
}

