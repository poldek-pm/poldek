# install-dist cannot resolve this conflict (by picking c) as regular install do
# and it simply report conflict here
testInstallDistConflictError() {
    skip_if_rpm_testing_off && return

    build a -r "foo" -r "bar"
    build b -p "foo" -p "bar" -c "a"
    build c -p "foo" -p "bar"
    build sh -p /bin/sh

    try_install --failok a ""
    if is_verbose_mode; then
        msg "THE ERROR ABOVE (1 unresolved dependency) is EXPECTED"
    fi
    $POLDEK_INSTALL a | grep -qP "error: b-1-1.*conflicts with a-1-1"
    assertEquals "poldek should report 1 conflict" "$?" "0"
}

testInstallDistConflictErrorForce() {
    skip_if_rpm_testing_off && return

    build a -r "foo" -r "bar"
    build b -p "foo" -p "bar" -c "a"
    build c -p "foo" -p "bar"
    build sh -p /bin/sh

    msgn "Install"
    try_install a "a,b,sh" --force
}

# --destination copies packages to a repository, it cannot install them
# under a root directory
testInstallDistWithDestinationRefused() {
    local dest=$ORIGREPO/pset out rc

    build a
    build sh -p /bin/sh
    mkdir -p $dest

    out=$($POLDEK_INSTALL --dt dir --destination $dest a 2>&1)
    rc=$?
    echo "$out"
    assertEquals "exit code" "1" "$rc"
    echo "$out" | grep -q -- "--install-dist cannot be used with --destination"
    assertEquals "not refused: $out" "0" "$?"
    assertEquals "files left under the root" "" "$(ls -A $DESTINATION_REPO)"
}


